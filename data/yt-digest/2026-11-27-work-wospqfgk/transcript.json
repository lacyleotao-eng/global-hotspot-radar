[
 {
  "t": "00:00:00",
  "text": "前兩天我在路上走去拿外賣的時候"
 },
 {
  "t": "00:00:02",
  "text": "想要趕在餐廳關門前去取餐"
 },
 {
  "t": "00:00:05",
  "text": "於是我穿了個拖鞋"
 },
 {
  "t": "00:00:06",
  "text": "就急急忙忙的出門了"
 },
 {
  "t": "00:00:08",
  "text": "結果走路走太快直接撲街啊"
 },
 {
  "t": "00:00:11",
  "text": "是真的整個人摔在地上"
 },
 {
  "t": "00:00:13",
  "text": "膝蓋都破皮了"
 },
 {
  "t": "00:00:14",
  "text": "回家我反思了一下"
 },
 {
  "t": "00:00:15",
  "text": "為什麽我會這麽趕呢"
 },
 {
  "t": "00:00:17",
  "text": "是因為我一直在工作忘記了看時間"
 },
 {
  "t": "00:00:20",
  "text": "於是拖到很晚餐廳都快關門了"
 },
 {
  "t": "00:00:22",
  "text": "我才order食物"
 },
 {
  "t": "00:00:24",
  "text": "我意識到的問題在於我太趕時間了"
 },
 {
  "t": "00:00:27",
  "text": "我想盡可能的去把事情都做完"
 },
 {
  "t": "00:00:30",
  "text": "我現在目前手頭上主要的工作有"
 },
 {
  "t": "00:00:32",
  "text": "做這個Youtube頻道"
 },
 {
  "t": "00:00:33",
  "text": "做電商品牌"
 },
 {
  "t": "00:00:35",
  "text": "每周要發電子報"
 },
 {
  "t": "00:00:36",
  "text": "還有我的付費社群的管理"
 },
 {
  "t": "00:00:38",
  "text": "還有兼職當狗保姆"
 },
 {
  "t": "00:00:41",
  "text": "每一個大項目底下都有"
 },
 {
  "t": "00:00:43",
  "text": "無數個小任務"
 },
 {
  "t": "00:00:44",
  "text": "每天都有新的靈感"
 },
 {
  "t": "00:00:45",
  "text": "和待辦事項冒出來"
 },
 {
  "t": "00:00:47",
  "text": "我需要一個能管理"
 },
 {
  "t": "00:00:48",
  "text": "這麽多任務的系統"
 },
 {
  "t": "00:00:50",
  "text": "我試過超多工具"
 },
 {
  "t": "00:00:51",
  "text": "特別是Notion"
 },
 {
  "t": "00:00:52",
  "text": "有很多很fancy的dashboard模板"
 },
 {
  "t": "00:00:54",
  "text": "我自己也嘗試用過無數遍"
 },
 {
  "t": "00:00:57",
  "text": "看著確實是很帥"
 },
 {
  "t": "00:00:58",
  "text": "我花了整整一天的時間"
 },
 {
  "t": "00:01:00",
  "text": "設置了一個完美的Notion工作空間"
 },
 {
  "t": "00:01:03",
  "text": "有項目看板"
 },
 {
  "t": "00:01:04",
  "text": "時間追蹤"
 },
 {
  "t": "00:01:05",
  "text": "目標設定甚至還有心情記錄"
 },
 {
  "t": "00:01:07",
  "text": "剛開始的時候我覺得自己好厲害"
 },
 {
  "t": "00:01:09",
  "text": "簡直是個時間管理大師"
 },
 {
  "t": "00:01:11",
  "text": "每次打開Notion就感覺自己很專業"
 },
 {
  "t": "00:01:14",
  "text": "但最後我都堅持不下去"
 },
 {
  "t": "00:01:16",
  "text": "因為太覆雜太花時間太難持續了"
 },
 {
  "t": "00:01:18",
  "text": "每次想記錄點什麽吧"
 },
 {
  "t": "00:01:20",
  "text": "都要想半天應該放在哪個板塊好呢"
 },
 {
  "t": "00:01:22",
  "text": "後來我發現了工具根本不是重點"
 },
 {
  "t": "00:01:25",
  "text": "重點是能不能打造出"
 },
 {
  "t": "00:01:27",
  "text": "一套真正適合自己的系統"
 },
 {
  "t": "00:01:29",
  "text": "一套簡單可以持續"
 },
 {
  "t": "00:01:31",
  "text": "不需要太多維護的系統"
 },
 {
  "t": "00:01:32",
  "text": "今天我就來分享一下"
 },
 {
  "t": "00:01:34",
  "text": "我現在使用的效率系統"
 },
 {
  "t": "00:01:36",
  "text": "它幫助我同時管理5個項目"
 },
 {
  "t": "00:01:38",
  "text": "而且最重要的是"
 },
 {
  "t": "00:01:39",
  "text": "所有用到的工具都是免費的"
 },
 {
  "t": "00:01:41",
  "text": "我自己的這套系統呢 我稱它為COTR"
 },
 {
  "t": "00:01:46",
  "text": "C就是capture"
 },
 {
  "t": "00:01:47",
  "text": "O organized整理  T take action行動 R remind提醒"
 },
 {
  "t": "00:01:50",
  "text": "第一步最重要的就是capture捕捉"
 },
 {
  "t": "00:01:53",
  "text": "那就是把腦子里的所有想法都倒出來"
 },
 {
  "t": "00:01:56",
  "text": "我用的工具很簡單"
 },
 {
  "t": "00:01:58",
  "text": "就是iPhone自帶的備忘錄"
 },
 {
  "t": "00:02:00",
  "text": "我最近呢"
 },
 {
  "t": "00:02:01",
  "text": "還設置了一個更懶的記錄方式"
 },
 {
  "t": "00:02:03",
  "text": "那就是我在我的iPhone的Action Button"
 },
 {
  "t": "00:02:05",
  "text": "里面設置了一個快捷按鈕"
 },
 {
  "t": "00:02:07",
  "text": "只要按Action Button就能直接的打開ChatGPT"
 },
 {
  "t": "00:02:11",
  "text": "我就能語音的記錄"
 },
 {
  "t": "00:02:12",
  "text": "有時候我在遛狗的時候"
 },
 {
  "t": "00:02:14",
  "text": "突然有個想法"
 },
 {
  "t": "00:02:15",
  "text": "但是只有一只手能用"
 },
 {
  "t": "00:02:16",
  "text": "我就能拿手機出來按一下Action Button"
 },
 {
  "t": "00:02:18",
  "text": "就可以直接跟我的ChatGPT對話"
 },
 {
  "t": "00:02:20",
  "text": "重點不是工具有多高級"
 },
 {
  "t": "00:02:22",
  "text": "而是要養成一個習慣"
 },
 {
  "t": "00:02:24",
  "text": "就是想到就要記下來"
 },
 {
  "t": "00:02:25",
  "text": "你的腦子就好像一個SSD"
 },
 {
  "t": "00:02:28",
  "text": "如果你的腦中積攢了太多的想法"
 },
 {
  "t": "00:02:31",
  "text": "沒有辦法及時拿出來的話"
 },
 {
  "t": "00:02:33",
  "text": "那你整個人就會很疲憊"
 },
 {
  "t": "00:02:34",
  "text": "其實我為什麽會走路"
 },
 {
  "t": "00:02:36",
  "text": "走路突然摔倒"
 },
 {
  "t": "00:02:37",
  "text": "也是因為我腦子里面有很多想法"
 },
 {
  "t": "00:02:39",
  "text": "所以我在走路的時候也在不斷思考"
 },
 {
  "t": "00:02:41",
  "text": "我下一個Video要講什麽"
 },
 {
  "t": "00:02:42",
  "text": "我下一個newsletter要講什麽"
 },
 {
  "t": "00:02:45",
  "text": "所有這些東西都在我的腦子里"
 },
 {
  "t": "00:02:46",
  "text": "所以我走路的時候"
 },
 {
  "t": "00:02:47",
  "text": "根本沒有當下在專心"
 },
 {
  "t": "00:02:49",
  "text": "在走路這件事情上"
 },
 {
  "t": "00:02:51",
  "text": "這就是為什麽我摔倒的原因"
 },
 {
  "t": "00:02:53",
  "text": "所以我們的大腦"
 },
 {
  "t": "00:02:54",
  "text": "不是用來儲存信息的"
 },
 {
  "t": "00:02:56",
  "text": "是用來處理"
 },
 {
  "t": "00:02:57",
  "text": "信息的"
 },
 {
  "t": "00:02:58",
  "text": "當你的腦子同時裝著要回覆郵件"
 },
 {
  "t": "00:03:00",
  "text": "明天買牛奶"
 },
 {
  "t": "00:03:01",
  "text": "下周的影片主題"
 },
 {
  "t": "00:03:03",
  "text": "這些雜七雜八的事情的時候"
 },
 {
  "t": "00:03:05",
  "text": "你根本"
 },
 {
  "t": "00:03:05",
  "text": "沒辦法專注於當下正在做的事情"
 },
 {
  "t": "00:03:08",
  "text": "把這些東西都記下來"
 },
 {
  "t": "00:03:10",
  "text": "你的大腦就自由了"
 },
 {
  "t": "00:03:11",
  "text": "我的這套系統"
 },
 {
  "t": "00:03:12",
  "text": "第二步就是organized整理"
 },
 {
  "t": "00:03:14",
  "text": "在每周日的晚上"
 },
 {
  "t": "00:03:16",
  "text": "我都會花一個時間進行大腦清理"
 },
 {
  "t": "00:03:19",
  "text": "這是我一周中最重要的一個小時"
 },
 {
  "t": "00:03:21",
  "text": "我用的工具呢是Milanote"
 },
 {
  "t": "00:03:23",
  "text": "這個工具我已經用了超過五"
 },
 {
  "t": "00:03:24",
  "text": "六年了吧"
 },
 {
  "t": "00:03:25",
  "text": "包括我自己"
 },
 {
  "t": "00:03:26",
  "text": "還有我電商品牌的整個團隊"
 },
 {
  "t": "00:03:28",
  "text": "我都是用Milanote"
 },
 {
  "t": "00:03:29",
  "text": "去管理我們的任務的"
 },
 {
  "t": "00:03:31",
  "text": "我選擇他的原因很簡單"
 },
 {
  "t": "00:03:32",
  "text": "第一個是他非常視覺化"
 },
 {
  "t": "00:03:34",
  "text": "可以像在墻上貼便利貼一樣"
 },
 {
  "t": "00:03:36",
  "text": "組織想法"
 },
 {
  "t": "00:03:37",
  "text": "第二個是免費版就已經夠用了"
 },
 {
  "t": "00:03:40",
  "text": "基本功能都不收費"
 },
 {
  "t": "00:03:41",
  "text": "第三個是他不會過度的複雜"
 },
 {
  "t": "00:03:43",
  "text": "比Notion簡單太多了"
 },
 {
  "t": "00:03:45",
  "text": "第四點就是他協作友好"
 },
 {
  "t": "00:03:47",
  "text": "可以跟團隊成員分享特定的板塊"
 },
 {
  "t": "00:03:50",
  "text": "而且分享功能呢也是完全免費的"
 },
 {
  "t": "00:03:53",
  "text": "整個過程很簡單"
 },
 {
  "t": "00:03:54",
  "text": "我把過去一周在第一步里"
 },
 {
  "t": "00:03:56",
  "text": "我capture捕捉到的所有的信息分類"
 },
 {
  "t": "00:03:59",
  "text": "按照我手頭上幾個大塊的任務"
 },
 {
  "t": "00:04:02",
  "text": "去分類我的想法"
 },
 {
  "t": "00:04:03",
  "text": "所以我在周日的晚上我就會坐下來"
 },
 {
  "t": "00:04:06",
  "text": "打開我的Milanote"
 },
 {
  "t": "00:04:07",
  "text": "把我腦中這些雜七雜八的想法"
 },
 {
  "t": "00:04:10",
  "text": "一個個按分類"
 },
 {
  "t": "00:04:11",
  "text": "分到我現在手頭上的任務上面去"
 },
 {
  "t": "00:04:14",
  "text": "比如說有YouTube區"
 },
 {
  "t": "00:04:16",
  "text": "電商區Newsletter區"
 },
 {
  "t": "00:04:18",
  "text": "社群區還有我的狗保姆區"
 },
 {
  "t": "00:04:20",
  "text": "還有我自己個人的生活區"
 },
 {
  "t": "00:04:22",
  "text": "很多人在這一步就放棄了"
 },
 {
  "t": "00:04:25",
  "text": "因為他們想一開始就做到完美"
 },
 {
  "t": "00:04:27",
  "text": "記住：完成比完美更重要"
 },
 {
  "t": "00:04:29",
  "text": "你的分類系統不需要像圖書館"
 },
 {
  "t": "00:04:31",
  "text": "索引那麽精確"
 },
 {
  "t": "00:04:33",
  "text": "只要你自己看得懂就可以了"
 },
 {
  "t": "00:04:34",
  "text": "我的分類方式"
 },
 {
  "t": "00:04:36",
  "text": "可能對你來說完全不適用"
 },
 {
  "t": "00:04:37",
  "text": "因為每個人手頭上的項目都不一樣"
 },
 {
  "t": "00:04:40",
  "text": "這很正常"
 },
 {
  "t": "00:04:41",
  "text": "重點是找到適合你的方式"
 },
 {
  "t": "00:04:43",
  "text": "第三步是take action行動"
 },
 {
  "t": "00:04:45",
  "text": "這是整個系統的核心"
 },
 {
  "t": "00:04:47",
  "text": "就是要把計劃轉化成行動"
 },
 {
  "t": "00:04:50",
  "text": "我用apple reminders來管理每天的任務"
 },
 {
  "t": "00:04:53",
  "text": "為什麽不用什麽其他"
 },
 {
  "t": "00:04:54",
  "text": "高級的管理任務工具呢"
 },
 {
  "t": "00:04:56",
  "text": "是因為apple reminder就"
 },
 {
  "t": "00:04:58",
  "text": "已經完全夠用了"
 },
 {
  "t": "00:04:59",
  "text": "並且他跟整個apple的生態系統"
 },
 {
  "t": "00:05:01",
  "text": "結合起來"
 },
 {
  "t": "00:05:02",
  "text": "可以很方便的同步到我的iPhone"
 },
 {
  "t": "00:05:05",
  "text": "Macbook還有我的iPad上面"
 },
 {
  "t": "00:05:07",
  "text": "另外它還有幾個我比較喜歡的功能"
 },
 {
  "t": "00:05:10",
  "text": "第一個就是位置提醒"
 },
 {
  "t": "00:05:11",
  "text": "你到了特定地點"
 },
 {
  "t": "00:05:13",
  "text": "他會提醒你在這里可以做這個任務"
 },
 {
  "t": "00:05:15",
  "text": "這點是時間提醒"
 },
 {
  "t": "00:05:17",
  "text": "在最合適的時間推送"
 },
 {
  "t": "00:05:18",
  "text": "比如說在早上我就"
 },
 {
  "t": "00:05:19",
  "text": "傾向於做一些創作的工作"
 },
 {
  "t": "00:05:21",
  "text": "所以在早上他會提醒我的"
 },
 {
  "t": "00:05:23",
  "text": "就是做一些比如說像腳本"
 },
 {
  "t": "00:05:25",
  "text": "編寫啊這些工作"
 },
 {
  "t": "00:05:26",
  "text": "第三點就是他跟系統深度的整合"
 },
 {
  "t": "00:05:29",
  "text": "可以用Siri語音直接添加任務"
 },
 {
  "t": "00:05:32",
  "text": "第四點簡單"
 },
 {
  "t": "00:05:33",
  "text": "我個人來說呢"
 },
 {
  "t": "00:05:34",
  "text": "我就傾向於用那些非常簡單的"
 },
 {
  "t": "00:05:36",
  "text": "不需要看很多教程"
 },
 {
  "t": "00:05:38",
  "text": "你一看就懂得那些產品"
 },
 {
  "t": "00:05:39",
  "text": "你不會因為功能太多而分心"
 },
 {
  "t": "00:05:41",
  "text": "所以每天早上我都會只看一個地方"
 },
 {
  "t": "00:05:44",
  "text": "就是今日的任務清單"
 },
 {
  "t": "00:05:45",
  "text": "這個清單通常包含1到2個大的任務"
 },
 {
  "t": "00:05:48",
  "text": "是需要深度專注去完成的工作"
 },
 {
  "t": "00:05:51",
  "text": "然後3到5個小任務"
 },
 {
  "t": "00:05:53",
  "text": "快速可以完成的事項"
 },
 {
  "t": "00:05:54",
  "text": "幾個日常維護的任務"
 },
 {
  "t": "00:05:56",
  "text": "比如說回覆郵件啊"
 },
 {
  "t": "00:05:57",
  "text": "社群互動等等"
 },
 {
  "t": "00:05:58",
  "text": "第四步是remind提醒"
 },
 {
  "t": "00:06:01",
  "text": "最後一步是確保"
 },
 {
  "t": "00:06:02",
  "text": "沒有任何重要的事情被遺忘"
 },
 {
  "t": "00:06:04",
  "text": "我主要用apple Calendar"
 },
 {
  "t": "00:06:06",
  "text": "去記錄我各種的日程"
 },
 {
  "t": "00:06:08",
  "text": "是因為他完美整合了apple"
 },
 {
  "t": "00:06:10",
  "text": "生態中的信息"
 },
 {
  "t": "00:06:11",
  "text": "包括Notes中的重要截止日期"
 },
 {
  "t": "00:06:14",
  "text": "reminders中的任務提醒"
 },
 {
  "t": "00:06:15",
  "text": "還有郵件中的會議邀請"
 },
 {
  "t": "00:06:17",
  "text": "短信中的約會安排"
 },
 {
  "t": "00:06:19",
  "text": "我都可以很輕松的"
 },
 {
  "t": "00:06:20",
  "text": "就把它同步到我的apple Calendar里面"
 },
 {
  "t": "00:06:23",
  "text": "每天早上我打開我的Apple Calendar"
 },
 {
  "t": "00:06:25",
  "text": "我就能看到我今天需要完成的任務"
 },
 {
  "t": "00:06:28",
  "text": "這周末我約了哪個朋友去哪個餐廳"
 },
 {
  "t": "00:06:31",
  "text": "甚至是"
 },
 {
  "t": "00:06:32",
  "text": "下個月我需要注意的所有事情"
 },
 {
  "t": "00:06:33",
  "text": "我都可以通過我的Apple Calendar"
 },
 {
  "t": "00:06:35",
  "text": "很清晰很直觀的看到"
 },
 {
  "t": "00:06:37",
  "text": "那麽我是怎麽用我的這個系統"
 },
 {
  "t": "00:06:39",
  "text": "去管理"
 },
 {
  "t": "00:06:40",
  "text": "我現在正在做的5個大項目的呢"
 },
 {
  "t": "00:06:42",
  "text": "第一個是YouTube創作流程"
 },
 {
  "t": "00:06:44",
  "text": "我的YouTube頻道每周更新一次"
 },
 {
  "t": "00:06:47",
  "text": "從靈感產生到視頻發布"
 },
 {
  "t": "00:06:49",
  "text": "整個流程呢大概需要5天"
 },
 {
  "t": "00:06:51",
  "text": "內容規劃階段"
 },
 {
  "t": "00:06:52",
  "text": "我用apple note記錄我"
 },
 {
  "t": "00:06:54",
  "text": "所有關於影片的想法"
 },
 {
  "t": "00:06:55",
  "text": "每當我看到有趣的人事物"
 },
 {
  "t": "00:06:58",
  "text": "或者是讀到任何有啟發的文章"
 },
 {
  "t": "00:07:00",
  "text": "或者"
 },
 {
  "t": "00:07:01",
  "text": "在評論區看到有觀眾提問的問題"
 },
 {
  "t": "00:07:03",
  "text": "我都會把這些記錄下來"
 },
 {
  "t": "00:07:04",
  "text": "到我的apple Notes裡"
 },
 {
  "t": "00:07:06",
  "text": "然後接下來就是腳本創作的階段"
 },
 {
  "t": "00:07:08",
  "text": "那麽關於腳本創作呢"
 },
 {
  "t": "00:07:10",
  "text": "我自己建立了一個系統"
 },
 {
  "t": "00:07:11",
  "text": "比如說我在我的靈感清單上面"
 },
 {
  "t": "00:07:13",
  "text": "找到關於productivity"
 },
 {
  "t": "00:07:15",
  "text": "生產力的"
 },
 {
  "t": "00:07:16",
  "text": "也就是你們正在看的這個影片"
 },
 {
  "t": "00:07:18",
  "text": "那麽我這周準備就做這個影片"
 },
 {
  "t": "00:07:20",
  "text": "我就會把這個想法提出來"
 },
 {
  "t": "00:07:21",
  "text": "然後把我腦中"
 },
 {
  "t": "00:07:23",
  "text": "關於這個影片雜亂的想法"
 },
 {
  "t": "00:07:25",
  "text": "先寫成一個簡單的大綱"
 },
 {
  "t": "00:07:27",
  "text": "然後我會把這個大綱去放到ChatGPT裡"
 },
 {
  "t": "00:07:30",
  "text": "我已經做了一個腳本編寫的一個GPT"
 },
 {
  "t": "00:07:33",
  "text": "我把這個大綱丟進去"
 },
 {
  "t": "00:07:34",
  "text": "然後他就會給我一個"
 },
 {
  "t": "00:07:36",
  "text": "比較基礎的腳本"
 },
 {
  "t": "00:07:37",
  "text": "框架"
 },
 {
  "t": "00:07:38",
  "text": "接著我會用claude去優化我的結構"
 },
 {
  "t": "00:07:41",
  "text": "我發現"
 },
 {
  "t": "00:07:41",
  "text": "claude在寫作上面是比ChatGPT要好的"
 },
 {
  "t": "00:07:45",
  "text": "他可以寫一篇"
 },
 {
  "t": "00:07:46",
  "text": "5,000 6,000字以上的文章是沒問題的"
 },
 {
  "t": "00:07:49",
  "text": "但是ChatGPT在我實際使用過程中"
 },
 {
  "t": "00:07:52",
  "text": "我發現ChatGPT他只能生成比較"
 },
 {
  "t": "00:07:54",
  "text": "短的段落"
 },
 {
  "t": "00:07:55",
  "text": "所以我要最後打磨我的腳本呢"
 },
 {
  "t": "00:07:57",
  "text": "我都會用claude"
 },
 {
  "t": "00:07:58",
  "text": "那麽這個時候"
 },
 {
  "t": "00:07:59",
  "text": "我大概能生成一個6,000字腳本以上"
 },
 {
  "t": "00:08:02",
  "text": "的第一版的draft"
 },
 {
  "t": "00:08:03",
  "text": "我在這個draft上面呢"
 },
 {
  "t": "00:08:05",
  "text": "我會在加入自己的個人經驗"
 },
 {
  "t": "00:08:07",
  "text": "個人故事"
 },
 {
  "t": "00:08:08",
  "text": "還有在語言上面也會"
 },
 {
  "t": "00:08:10",
  "text": "更符合我個人講話的風格"
 },
 {
  "t": "00:08:12",
  "text": "接下來我就會拿著這個腳本"
 },
 {
  "t": "00:08:14",
  "text": "去錄制 A Roll"
 },
 {
  "t": "00:08:15",
  "text": "也就是平常我直接對著攝影機"
 },
 {
  "t": "00:08:17",
  "text": "的那些片段"
 },
 {
  "t": "00:08:18",
  "text": "接下來我會拍攝B Roll"
 },
 {
  "t": "00:08:20",
  "text": "讓整個影片更加流暢的補充畫面"
 },
 {
  "t": "00:08:23",
  "text": "再接下來就是影片的剪輯階段了"
 },
 {
  "t": "00:08:25",
  "text": "在這里我就不贅述"
 },
 {
  "t": "00:08:27",
  "text": "關於影片剪輯的小細節了"
 },
 {
  "t": "00:08:29",
  "text": "在之後如果觀眾有興趣的話"
 },
 {
  "t": "00:08:30",
  "text": "我可以專門出一期講"
 },
 {
  "t": "00:08:32",
  "text": "整個"
 },
 {
  "t": "00:08:33",
  "text": "YouTube影片的制作流程"
 },
 {
  "t": "00:08:34",
  "text": "的更詳細化的影片"
 },
 {
  "t": "00:08:36",
  "text": "那麽在這個影片我只是簡單的去說"
 },
 {
  "t": "00:08:39",
  "text": "不同的階段"
 },
 {
  "t": "00:08:40",
  "text": "我會通過哪些工具去輔助我"
 },
 {
  "t": "00:08:42",
  "text": "更好的更有系統的去發布影片"
 },
 {
  "t": "00:08:44",
  "text": "那麽剪輯完之後我就會上傳影片到"
 },
 {
  "t": "00:08:47",
  "text": "Youtube的後台 再接下來就是做影片的封面"
 },
 {
  "t": "00:08:50",
  "text": "然後寫影片的標題還有影片的描述"
 },
 {
  "t": "00:08:53",
  "text": "這三步"
 },
 {
  "t": "00:08:54",
  "text": "除了設計我會在Canva完成以外"
 },
 {
  "t": "00:08:56",
  "text": "其他的兩步我都會在Milanote上面"
 },
 {
  "t": "00:08:59",
  "text": "記錄我的想法"
 },
 {
  "t": "00:09:00",
  "text": "包括一些提前寫好的"
 },
 {
  "t": "00:09:02",
  "text": "模板我都會放在我的Milanote上面去"
 },
 {
  "t": "00:09:04",
  "text": "然後接下來是我第二個大項目"
 },
 {
  "t": "00:09:06",
  "text": "就是電商的運營"
 },
 {
  "t": "00:09:07",
  "text": "這是一個跟"
 },
 {
  "t": "00:09:08",
  "text": "內容創作完全不同的工作模式"
 },
 {
  "t": "00:09:11",
  "text": "需要管理我的VA"
 },
 {
  "t": "00:09:12",
  "text": "還有處理客服"
 },
 {
  "t": "00:09:13",
  "text": "還有供應鏈等等的問題"
 },
 {
  "t": "00:09:15",
  "text": "我跟我的團隊同樣也是用Milanote"
 },
 {
  "t": "00:09:18",
  "text": "在這里我建立了幾個我們之間"
 },
 {
  "t": "00:09:20",
  "text": "團隊共享的板塊"
 },
 {
  "t": "00:09:21",
  "text": "第一個就是在處理的特殊的訂單"
 },
 {
  "t": "00:09:24",
  "text": "有一些訂單是需要customize的"
 },
 {
  "t": "00:09:27",
  "text": "第二個就是客服問題"
 },
 {
  "t": "00:09:28",
  "text": "我的VA（助理）會把常見的問題還有SOP"
 },
 {
  "t": "00:09:31",
  "text": "還有近期"
 },
 {
  "t": "00:09:32",
  "text": "比較多顧客去反映的問題"
 },
 {
  "t": "00:09:34",
  "text": "都會放到客服的這個板塊里面"
 },
 {
  "t": "00:09:36",
  "text": "第三個板塊是內容素材"
 },
 {
  "t": "00:09:38",
  "text": "我們的產品圖片文案營銷素材"
 },
 {
  "t": "00:09:41",
  "text": "我們都會把這些素材放在Canva"
 },
 {
  "t": "00:09:44",
  "text": "或者是Google Drive上面去"
 },
 {
  "t": "00:09:46",
  "text": "然後把這些Link"
 },
 {
  "t": "00:09:47",
  "text": "都放到Milanote上面去統一管理"
 },
 {
  "t": "00:09:49",
  "text": "在這里"
 },
 {
  "t": "00:09:50",
  "text": "關鍵 同樣的 不是工具有多高級"
 },
 {
  "t": "00:09:52",
  "text": "而是流程是否清晰"
 },
 {
  "t": "00:09:54",
  "text": "我們的規則很簡單"
 },
 {
  "t": "00:09:55",
  "text": "1：每個任務都有明確的負責人"
 },
 {
  "t": "00:09:58",
  "text": "第二個"
 },
 {
  "t": "00:09:58",
  "text": "每個任務都有明確的截止時間"
 },
 {
  "t": "00:10:00",
  "text": "第三個是完成後"
 },
 {
  "t": "00:10:02",
  "text": "移動到已完成的區域"
 },
 {
  "t": "00:10:04",
  "text": "第四點是遇到問題"
 },
 {
  "t": "00:10:05",
  "text": "立即在相應任務下面留言"
 },
 {
  "t": "00:10:07",
  "text": "那麽第三個"
 },
 {
  "t": "00:10:08",
  "text": "我目前手頭上正在做的任務呢"
 },
 {
  "t": "00:10:10",
  "text": "就是newsletter的管理"
 },
 {
  "t": "00:10:12",
  "text": "我每周會發送一期關於AI工具啊"
 },
 {
  "t": "00:10:15",
  "text": "或者是生產力啊"
 },
 {
  "t": "00:10:17",
  "text": "或者是我最近在看什麽電影電視"
 },
 {
  "t": "00:10:19",
  "text": "或者是有好的YouTube頻道"
 },
 {
  "t": "00:10:21",
  "text": "或者是Podcast推薦"
 },
 {
  "t": "00:10:23",
  "text": "我都會放到我的newsletter里面"
 },
 {
  "t": "00:10:25",
  "text": "所以我必須要針對這個電子報"
 },
 {
  "t": "00:10:26",
  "text": "也要做一個管理系統"
 },
 {
  "t": "00:10:28",
  "text": "才能讓我"
 },
 {
  "t": "00:10:29",
  "text": "每周都可以固定的發送電子報"
 },
 {
  "t": "00:10:31",
  "text": "有源源不斷的靈感"
 },
 {
  "t": "00:10:33",
  "text": "我有一個"
 },
 {
  "t": "00:10:34",
  "text": "持續的內容發現流程"
 },
 {
  "t": "00:10:36",
  "text": "第一個 我會每天花15分鐘去瀏覽"
 },
 {
  "t": "00:10:38",
  "text": "Product Hunt上面的新產品"
 },
 {
  "t": "00:10:40",
  "text": "然後我自己會試用"
 },
 {
  "t": "00:10:41",
  "text": "試用過確實是好的產品"
 },
 {
  "t": "00:10:43",
  "text": "我會記錄下來"
 },
 {
  "t": "00:10:44",
  "text": "然後再確定"
 },
 {
  "t": "00:10:45",
  "text": "是不是要做一期特別的影片去介紹它"
 },
 {
  "t": "00:10:47",
  "text": "還是說把它放在Newsletter里面"
 },
 {
  "t": "00:10:50",
  "text": "第二點"
 },
 {
  "t": "00:10:50",
  "text": "我會關注幾個關鍵的AI工具"
 },
 {
  "t": "00:10:53",
  "text": "聚合網站"
 },
 {
  "t": "00:10:54",
  "text": "第三個是我每天都會泡澡"
 },
 {
  "t": "00:10:55",
  "text": "所以我在泡澡的時候呢就會刷x"
 },
 {
  "t": "00:10:58",
  "text": "看x上面有大神有哪些工具的推薦"
 },
 {
  "t": "00:11:02",
  "text": "我就會記在我的apple note上面去"
 },
 {
  "t": "00:11:04",
  "text": "如果有觀眾"
 },
 {
  "t": "00:11:05",
  "text": "想了解我是如何了解這些AI信息的"
 },
 {
  "t": "00:11:08",
  "text": "可以在評論區告訴我（之後出一期專門介紹）"
 },
 {
  "t": "00:11:10",
  "text": "第四個"
 },
 {
  "t": "00:11:10",
  "text": "我手頭正在做的比較大的任務"
 },
 {
  "t": "00:11:13",
  "text": "就是我的付費社群的管理"
 },
 {
  "t": "00:11:15",
  "text": "每天我都會花30分鐘左右的時間"
 },
 {
  "t": "00:11:17",
  "text": "去回答付費社群成員的一些提問"
 },
 {
  "t": "00:11:20",
  "text": "然後每天我都會更新一個帖子"
 },
 {
  "t": "00:11:22",
  "text": "在我的電商付費社群里面"
 },
 {
  "t": "00:11:24",
  "text": "第5個我目前手頭上正在做的工作"
 },
 {
  "t": "00:11:27",
  "text": "是寵物保姆"
 },
 {
  "t": "00:11:28",
  "text": "這個呢就主要是在家工作的好處"
 },
 {
  "t": "00:11:30",
  "text": "那麽"
 },
 {
  "t": "00:11:30",
  "text": "如果大家對於我在家做寵物保姆"
 },
 {
  "t": "00:11:33",
  "text": "每個月可以掙多少錢"
 },
 {
  "t": "00:11:34",
  "text": "我之前做了一支影片去專門去講解"
 },
 {
  "t": "00:11:37",
  "text": "有興趣的朋友可以點擊"
 },
 {
  "t": "00:11:39",
  "text": "影片描述欄觀看"
 },
 {
  "t": "00:11:40",
  "text": "那麽這個工作呢"
 },
 {
  "t": "00:11:41",
  "text": "其實主要分成客戶管理"
 },
 {
  "t": "00:11:44",
  "text": "所有的預約"
 },
 {
  "t": "00:11:45",
  "text": "我都是用Apple Calendar去管理的"
 },
 {
  "t": "00:11:47",
  "text": "並且每一個狗狗"
 },
 {
  "t": "00:11:48",
  "text": "我都會有一個CRM的系統去管理"
 },
 {
  "t": "00:11:50",
  "text": "他們的一些"
 },
 {
  "t": "00:11:51",
  "text": "特殊要求"
 },
 {
  "t": "00:11:52",
  "text": "比如說他們的energy level啊"
 },
 {
  "t": "00:11:54",
  "text": "他們是不是需要喂藥啊"
 },
 {
  "t": "00:11:56",
  "text": "他們每天要走多少次啊"
 },
 {
  "t": "00:11:58",
  "text": "同樣的這個狗狗的CRM系統"
 },
 {
  "t": "00:12:00",
  "text": "我也是放在我的Milanote上面去"
 },
 {
  "t": "00:12:02",
  "text": "然後另外"
 },
 {
  "t": "00:12:03",
  "text": "一個就是標準化我的流程"
 },
 {
  "t": "00:12:05",
  "text": "每一次服務呢"
 },
 {
  "t": "00:12:06",
  "text": "都有一個標準的檢查清單"
 },
 {
  "t": "00:12:08",
  "text": "好總結一下"
 },
 {
  "t": "00:12:09",
  "text": "現在你已經看到了我每個"
 },
 {
  "t": "00:12:11",
  "text": "項目的具體運作方式"
 },
 {
  "t": "00:12:12",
  "text": "但最關鍵的問題是"
 },
 {
  "t": "00:12:14",
  "text": "如何讓這5個完全不同的項目"
 },
 {
  "t": "00:12:17",
  "text": "和諧運作"
 },
 {
  "t": "00:12:17",
  "text": "而不是互相沖突呢"
 },
 {
  "t": "00:12:19",
  "text": "其實我發現啊"
 },
 {
  "t": "00:12:20",
  "text": "比時間管理更重要的是能量管理"
 },
 {
  "t": "00:12:23",
  "text": "每個人在一天當中的不同時段"
 },
 {
  "t": "00:12:25",
  "text": "都會有不同的能量水平"
 },
 {
  "t": "00:12:27",
  "text": "那麽我自己的能量節奏呢"
 },
 {
  "t": "00:12:29",
  "text": "就是早上6點到12點"
 },
 {
  "t": "00:12:31",
  "text": "這段時間是執行力最強的"
 },
 {
  "t": "00:12:33",
  "text": "所以我會做寫腳本啊"
 },
 {
  "t": "00:12:35",
  "text": "構思內容等等需要動腦的一些任務"
 },
 {
  "t": "00:12:38",
  "text": "然後中午 1點到3點"
 },
 {
  "t": "00:12:40",
  "text": "因為這段時間陽光比較好啊"
 },
 {
  "t": "00:12:42",
  "text": "所以我就會做一些拍攝的工作"
 },
 {
  "t": "00:12:44",
  "text": "然後是下午3點到5點"
 },
 {
  "t": "00:12:47",
  "text": "我就會用來做一些溝通交流的任務"
 },
 {
  "t": "00:12:50",
  "text": "比如說回覆郵件啊"
 },
 {
  "t": "00:12:51",
  "text": "社群互動啊等等的任務"
 },
 {
  "t": "00:12:53",
  "text": "然後晚上6點之後"
 },
 {
  "t": "00:12:54",
  "text": "我就只會做一些不用動腦的"
 },
 {
  "t": "00:12:57",
  "text": "最輕松的任務"
 },
 {
  "t": "00:12:58",
  "text": "比如說跟我的狗狗客戶玩耍啊等等"
 },
 {
  "t": "00:13:00",
  "text": "我會把最需要創造力的任務"
 },
 {
  "t": "00:13:03",
  "text": "安排在精力最好的時段"
 },
 {
  "t": "00:13:05",
  "text": "把機械性的任務"
 },
 {
  "t": "00:13:06",
  "text": "留到精力較低的時候"
 },
 {
  "t": "00:13:08",
  "text": "下面是幾個小tips"
 },
 {
  "t": "00:13:09",
  "text": "那就是項目之間的協同效應"
 },
 {
  "t": "00:13:12",
  "text": "比如說YouTube影片中的精華部分呢"
 },
 {
  "t": "00:13:15",
  "text": "就可以變成社群媒體的內容"
 },
 {
  "t": "00:13:17",
  "text": "newsletter中的工具推薦呢"
 },
 {
  "t": "00:13:19",
  "text": "又可以成為影片的素材"
 },
 {
  "t": "00:13:21",
  "text": "電商品牌的經營過程中"
 },
 {
  "t": "00:13:23",
  "text": "獲得的經驗呢"
 },
 {
  "t": "00:13:24",
  "text": "又可以成為我YouTube影片的內容"
 },
 {
  "t": "00:13:27",
  "text": "還有一個小tips"
 },
 {
  "t": "00:13:28",
  "text": "那就是避免切換成本"
 },
 {
  "t": "00:13:30",
  "text": "同類的任務最好是批量去處理"
 },
 {
  "t": "00:13:33",
  "text": "比如說"
 },
 {
  "t": "00:13:33",
  "text": "所有的社群回覆在統一的時間完成"
 },
 {
  "t": "00:13:37",
  "text": "所有的郵件"
 },
 {
  "t": "00:13:38",
  "text": "在特定的時間內集中處理"
 },
 {
  "t": "00:13:40",
  "text": "所有的創造性工作"
 },
 {
  "t": "00:13:41",
  "text": "在精力最好的時候"
 },
 {
  "t": "00:13:43",
  "text": "連續進行"
 },
 {
  "t": "00:13:44",
  "text": "還記得影片開頭的時候"
 },
 {
  "t": "00:13:45",
  "text": "我提到我因為走路太快而"
 },
 {
  "t": "00:13:48",
  "text": "撲街的故事嗎"
 },
 {
  "t": "00:13:49",
  "text": "當你有一個好的"
 },
 {
  "t": "00:13:50",
  "text": "系統去管理你的任務的時候"
 },
 {
  "t": "00:13:52",
  "text": "你的生活就會比較有規律"
 },
 {
  "t": "00:13:55",
  "text": "即使工作再投入"
 },
 {
  "t": "00:13:56",
  "text": "也不會錯過重要的生活節奏"
 },
 {
  "t": "00:13:58",
  "text": "這就是一個好系統的力量"
 },
 {
  "t": "00:14:00",
  "text": "它不是讓你工作更多"
 },
 {
  "t": "00:14:02",
  "text": "而是讓你工作更智慧"
 },
 {
  "t": "00:14:04",
  "text": "每一個人的工作性質"
 },
 {
  "t": "00:14:06",
  "text": "思考方式和生活節奏都不同"
 },
 {
  "t": "00:14:08",
  "text": "最好的系統就是適合你自己的系統"
 },
 {
  "t": "00:14:11",
  "text": "你可以拿一張紙出來"
 },
 {
  "t": "00:14:12",
  "text": "寫出你目前的主要工作項目"
 },
 {
  "t": "00:14:15",
  "text": "每一個項目有哪些環節"
 },
 {
  "t": "00:14:17",
  "text": "哪些任務可以批量處理"
 },
 {
  "t": "00:14:19",
  "text": "哪些工作需要特定的精力狀態"
 },
 {
  "t": "00:14:21",
  "text": "項目之間有什麽協同的機會"
 },
 {
  "t": "00:14:23",
  "text": "然後思考現有的這些工具"
 },
 {
  "t": "00:14:25",
  "text": "能不能支持這些流程"
 },
 {
  "t": "00:14:27",
  "text": "哪些地方最容易出錯或者是遺漏"
 },
 {
  "t": "00:14:30",
  "text": "什麽時間做什麽事情最有效率"
 },
 {
  "t": "00:14:32",
  "text": "如何能減少不必要的切換和干擾"
 },
 {
  "t": "00:14:35",
  "text": "系統是為了減少決策"
 },
 {
  "t": "00:14:37",
  "text": "不是增加負擔"
 },
 {
  "t": "00:14:39",
  "text": "最好的系統是你會持續使用的系統"
 },
 {
  "t": "00:14:42",
  "text": "效率系統的真正目的"
 },
 {
  "t": "00:14:43",
  "text": "不是讓你變成工作機器"
 },
 {
  "t": "00:14:45",
  "text": "而是讓你能夠更"
 },
 {
  "t": "00:14:47",
  "text": "輕松的完成必要的工作"
 },
 {
  "t": "00:14:49",
  "text": "騰出時間"
 },
 {
  "t": "00:14:50",
  "text": "和精力"
 },
 {
  "t": "00:14:50",
  "text": "去做那些"
 },
 {
  "t": "00:14:51",
  "text": "真正讓你快樂和充實的事情"
 },
 {
  "t": "00:14:53",
  "text": "無論是陪伴家人"
 },
 {
  "t": "00:14:54",
  "text": "發展興趣還是學習新的技能"
 },
 {
  "t": "00:14:57",
  "text": "還是單純的就想放松休息"
 },
 {
  "t": "00:14:59",
  "text": "這些才是生活的意義所在"
 },
 {
  "t": "00:15:01",
  "text": "放慢節奏"
 },
 {
  "t": "00:15:02",
  "text": "聰明工作"
 },
 {
  "t": "00:15:03",
  "text": "做有價值的事情"
 },
 {
  "t": "00:15:04",
  "text": "並在這個過程中享受生活"
 },
 {
  "t": "00:15:06",
  "text": "如果你覺得這個影片對你有幫助"
 },
 {
  "t": "00:15:08",
  "text": "可以點個👍贊哦"
 },
 {
  "t": "00:15:10",
  "text": "我會把今天提到的所有工具清單"
 },
 {
  "t": "00:15:12",
  "text": "教程和模板都會整理發送在我的"
 },
 {
  "t": "00:15:15",
  "text": "電子報里"
 },
 {
  "t": "00:15:16",
  "text": "你可以在影片描述處"
 },
 {
  "t": "00:15:17",
  "text": "找到訂閱鏈接"
 },
 {
  "t": "00:15:19",
  "text": "每周我也會在我的電子報當中分享"
 },
 {
  "t": "00:15:22",
  "text": "我新發現的AI有趣工具"
 },
 {
  "t": "00:15:24",
  "text": "都是我親自測試過 或者是使用過的工具"
 },
 {
  "t": "00:15:26",
  "text": "如果你有任何問題"
 },
 {
  "t": "00:15:28",
  "text": "或者想分享你自己的效率系統"
 },
 {
  "t": "00:15:30",
  "text": "也歡迎在評論區留言"
 },
 {
  "t": "00:15:31",
  "text": "如果你對於我的電商"
 },
 {
  "t": "00:15:33",
  "text": "還有我的寵物保姆"
 },
 {
  "t": "00:15:34",
  "text": "這兩個工作感興趣的話"
 },
 {
  "t": "00:15:36",
  "text": "可以在影片下方找到鏈接"
 },
 {
  "t": "00:15:38",
  "text": "去回看我在Amazon"
 },
 {
  "t": "00:15:40",
  "text": "和我通過做狗保姆"
 },
 {
  "t": "00:15:42",
  "text": "每個月能賺到多少錢"
 },
 {
  "t": "00:15:43",
  "text": "我是Brayden布萊登"
 },
 {
  "t": "00:15:45",
  "text": "我們下期再見啦 👋 拜拜"
 },
 {
  "t": "00:15:48",
  "text": "真的還是假的"
 },
 {
  "t": "00:15:49",
  "text": "已經到了嗎"
 },
 {
  "t": "00:15:50",
  "text": "這就是嗎"
 },
 {
  "t": "00:15:52",
  "text": "看起來不像"
 },
 {
  "t": "00:15:54",
  "text": "（正在開去Windows XP牆紙的拍攝地😂）"
 }
