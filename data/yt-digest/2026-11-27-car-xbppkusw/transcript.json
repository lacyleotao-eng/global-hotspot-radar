[
 {
  "t": "00:00:00",
  "text": "Hello大家好 我是KENDI"
 },
 {
  "t": "00:00:01",
  "text": "一年时间又到了"
 },
 {
  "t": "00:00:02",
  "text": "今天我要给我老婆的车换一下机油"
 },
 {
  "t": "00:00:04",
  "text": "那在今天视频中"
 },
 {
  "t": "00:00:05",
  "text": "我会快速简单地讲一下"
 },
 {
  "t": "00:00:07",
  "text": "怎么给你自己的车换机油"
 },
 {
  "t": "00:00:08",
  "text": "在换的过程中我当然也会讲讲"
 },
 {
  "t": "00:00:10",
  "text": "给近代的新车换机油需要注意的问题"
 },
 {
  "t": "00:00:12",
  "text": "比如宝马没有机油尺该怎么办"
 },
 {
  "t": "00:00:13",
  "text": "以及重置保养提示灯的方法"
 },
 {
  "t": "00:00:15",
  "text": "最后我会讨论一下在家自己保养车的各种好处"
 },
 {
  "t": "00:00:17",
  "text": "如何处理旧机油"
 },
 {
  "t": "00:00:19",
  "text": "以及如何买到打折半价的机油"
 },
 {
  "t": "00:00:21",
  "text": "那好了话不多说"
 },
 {
  "t": "00:00:22",
  "text": "下面就让我们开始吧"
 },
 {
  "t": "00:00:26",
  "text": "每次换机油你需要给你车购买一桶机油"
 },
 {
  "t": "00:00:28",
  "text": "还有合适的机滤"
 },
 {
  "t": "00:00:30",
  "text": "另外你可以准备一个机油盘或者水桶"
 },
 {
  "t": "00:00:32",
  "text": "来接你的旧机油"
 },
 {
  "t": "00:00:33",
  "text": "如果有条件的话再准备一个漏斗就更好了"
 },
 {
  "t": "00:00:35",
  "text": "这样你倒机油的时候不容易撒"
 },
 {
  "t": "00:00:37",
  "text": "除了这些东西以外"
 },
 {
  "t": "00:00:38",
  "text": "很显然你还需要你车合适的套筒或者扳手"
 },
 {
  "t": "00:00:40",
  "text": "用来拧车上的放油螺丝"
 },
 {
  "t": "00:00:42",
  "text": "购买机油的时候注意看两个点"
 },
 {
  "t": "00:00:43",
  "text": "其中最基础一点就是它的粘度"
 },
 {
  "t": "00:00:45",
  "text": "我老婆这个车需要用到"
 },
 {
  "t": "00:00:47",
  "text": "比较稀的5w30粘度的机油"
 },
 {
  "t": "00:00:49",
  "text": "除了粘度以外 更重要的一点"
 },
 {
  "t": "00:00:50",
  "text": "我们要看机油的API rating"
 },
 {
  "t": "00:00:53",
  "text": "对汽油车来说这点不是很重要"
 },
 {
  "t": "00:00:54",
  "text": "但对精密的柴油车来说这点就非常重要"
 },
 {
  "t": "00:00:57",
  "text": "像我用的这个机油"
 },
 {
  "t": "00:00:58",
  "text": "这边只给了汽油的数据 SN"
 },
 {
  "t": "00:01:00",
  "text": "所以这桶机油非常便宜"
 },
 {
  "t": "00:01:01",
  "text": "因为它不是设计给柴油车用的"
 },
 {
  "t": "00:01:03",
  "text": "如果是柴油车的话"
 },
 {
  "t": "00:01:04",
  "text": "同样你要买符合你(车)规格API rating的机油"
 },
 {
  "t": "00:01:07",
  "text": "刚说的这些数据每辆车都是不同的"
 },
 {
  "t": "00:01:09",
  "text": "但是你的汽车保养手册上都会有(写)"
 },
 {
  "t": "00:01:11",
  "text": "没有的话 网上查一查也是非常方便的"
 },
 {
  "t": "00:01:13",
  "text": "机滤的话同样也是"
 },
 {
  "t": "00:01:14",
  "text": "购买你车需要使用机滤的型号就可以了"
 },
 {
  "t": "00:01:17",
  "text": "我这个是在Supercheap Auto买的"
 },
 {
  "t": "00:01:19",
  "text": "所有汽配商店都可以订到任何汽车型号的机滤"
 },
 {
  "t": "00:01:22",
  "text": "你只需要去店里问店员要就行了"
 },
 {
  "t": "00:01:25",
  "text": "由于这辆车放油螺丝在比较靠后的位置"
 },
 {
  "t": "00:01:27",
  "text": "所以这里我先要用千斤顶把车架起来"
 },
 {
  "t": "00:01:29",
  "text": "其实也有很多车放油螺丝位置设计得好的话"
 },
 {
  "t": "00:01:31",
  "text": "不需要把车架起来就可以换机油"
 },
 {
  "t": "00:01:33",
  "text": "我之前当然也演示过"
 },
 {
  "t": "00:01:35",
  "text": "把车架起来以后"
 },
 {
  "t": "00:01:36",
  "text": "必须要把车落到这样安全的铁支架上"
 },
 {
  "t": "00:01:39",
  "text": "你才能钻下去开工"
 },
 {
  "t": "00:01:40",
  "text": "要不然千斤顶液压结构可能会出现问题"
 },
 {
  "t": "00:01:42",
  "text": "砸下来你人就sǐ了"
 },
 {
  "t": "00:01:43",
  "text": "落到这样铁支架上安全程度"
 },
 {
  "t": "00:01:45",
  "text": "就可以远远高于修车厂的升降机"
 },
 {
  "t": "00:01:47",
  "text": "这样我们就可以安全得在下面干活了"
 },
 {
  "t": "00:01:49",
  "text": "另外值得注意的是"
 },
 {
  "t": "00:01:50",
  "text": "由于我这辆车的放油螺丝"
 },
 {
  "t": "00:01:51",
  "text": "正好在整个发动机油底壳的最后边"
 },
 {
  "t": "00:01:53",
  "text": "所以我把车头架起来就够了"
 },
 {
  "t": "00:01:55",
  "text": "油就可以彻底地倒出来"
 },
 {
  "t": "00:01:56",
  "text": "如果你的放油螺丝在侧面或者靠前的位置"
 },
 {
  "t": "00:01:59",
  "text": "我建议你把车前后都架起来"
 },
 {
  "t": "00:02:00",
  "text": "把整个车架平"
 },
 {
  "t": "00:02:01",
  "text": "这样待会放机油的时候"
 },
 {
  "t": "00:02:03",
  "text": "才能更彻底的把机油放出来没有残留"
 },
 {
  "t": "00:02:05",
  "text": "现在我进入车底"
 },
 {
  "t": "00:02:06",
  "text": "这个位置是这辆车机油的放油口"
 },
 {
  "t": "00:02:08",
  "text": "上面有个塑料盖"
 },
 {
  "t": "00:02:09",
  "text": "我现在打开一下"
 },
 {
  "t": "00:02:11",
  "text": "然后就可以看到我的放油螺丝了"
 },
 {
  "t": "00:02:13",
  "text": "把接机油的盘或者水桶先放在下面接好"
 },
 {
  "t": "00:02:15",
  "text": "我这辆车的放油螺丝是17毫米的"
 },
 {
  "t": "00:02:17",
  "text": "我用17毫米的套筒把放油螺丝给松开"
 },
 {
  "t": "00:02:20",
  "text": "这样机油就可以从下面放出来了"
 },
 {
  "t": "00:02:23",
  "text": "拔螺丝的时候注意不要把螺丝掉到下面的机油桶中"
 },
 {
  "t": "00:02:26",
  "text": "这里就放在这边让它漏一会儿"
 },
 {
  "t": "00:02:28",
  "text": "我们上来打开引擎盖"
 },
 {
  "t": "00:02:31",
  "text": "可以先把机油盖给拧开"
 },
 {
  "t": "00:02:32",
  "text": "这样的话下面的油可以漏得快一点"
 },
 {
  "t": "00:02:35",
  "text": "我这辆车用的是一个内胆式的机油滤芯"
 },
 {
  "t": "00:02:37",
  "text": "里面只有一个芯子"
 },
 {
  "t": "00:02:39",
  "text": "不是带壳的"
 },
 {
  "t": "00:02:40",
  "text": "有时候你会看到你的机油滤芯直接是一个带铁壳的"
 },
 {
  "t": "00:02:44",
  "text": "也是非常常见的"
 },
 {
  "t": "00:02:45",
  "text": "这里会稍微有点不一样"
 },
 {
  "t": "00:02:46",
  "text": "如果你的机油滤芯直接是铁壳的这种"
 },
 {
  "t": "00:02:49",
  "text": "你找到你的机油滤芯"
 },
 {
  "t": "00:02:50",
  "text": "然后把它整个拧下来"
 },
 {
  "t": "00:02:51",
  "text": "再把新的直接给拧回去就可以了"
 },
 {
  "t": "00:02:53",
  "text": "有些车的机油滤芯在上面 像我一样"
 },
 {
  "t": "00:02:55",
  "text": "有些车的机油滤芯在侧面或者下面"
 },
 {
  "t": "00:02:57",
  "text": "从总之一般都是在非常好换的地方"
 },
 {
  "t": "00:02:59",
  "text": "因为这个东西得经常拆"
 },
 {
  "t": "00:03:00",
  "text": "像我这边的情况"
 },
 {
  "t": "00:03:01",
  "text": "我有一个专门拆这个盖的套筒"
 },
 {
  "t": "00:03:03",
  "text": "我就可以使用这个套筒把机油滤芯的盖子给拧开"
 },
 {
  "t": "00:03:07",
  "text": "如果你没有专用的套筒也没关系"
 },
 {
  "t": "00:03:09",
  "text": "像这种钳子都可以用"
 },
 {
  "t": "00:03:10",
  "text": "你夹着这个一样可以拧下来"
 },
 {
  "t": "00:03:11",
  "text": "我以前同样也都演示过"
 },
 {
  "t": "00:03:14",
  "text": "盖子拧开以后就可以看到我们要更换的机油滤芯了"
 },
 {
  "t": "00:03:18",
  "text": "我们把机滤拿出来的时候"
 },
 {
  "t": "00:03:19",
  "text": "注意底下不要有橡胶圈什么的遗留在里面"
 },
 {
  "t": "00:03:22",
  "text": "我这辆车是没有的 所以我不是太担心"
 },
 {
  "t": "00:03:24",
  "text": "如果你有的话稍微检查一下"
 },
 {
  "t": "00:03:25",
  "text": "该换的橡胶圈都要给它取出来更换"
 },
 {
  "t": "00:03:27",
  "text": "一般拆出来的机油滤芯我会放在新的盒子里"
 },
 {
  "t": "00:03:30",
  "text": "这样子就不容易把油渗得一塌糊涂"
 },
 {
  "t": "00:03:32",
  "text": "整个我在一起去丢掉就行了"
 },
 {
  "t": "00:03:34",
  "text": "刚才机油盖上这两个橡胶圈"
 },
 {
  "t": "00:03:37",
  "text": "就是我说的要更换的东西"
 },
 {
  "t": "00:03:38",
  "text": "这些东西都是一次性的"
 },
 {
  "t": "00:03:40",
  "text": "如果你不更换的话"
 },
 {
  "t": "00:03:41",
  "text": "有可能导致你下次漏油 就非常恶心"
 },
 {
  "t": "00:03:43",
  "text": "而且你每次买机滤的时候"
 },
 {
  "t": "00:03:44",
  "text": "它里面都会给你橡胶圈"
 },
 {
  "t": "00:03:46",
  "text": "所以你没有不换的理由"
 },
 {
  "t": "00:03:48",
  "text": "我把这两个橡胶圈给挑下来"
 },
 {
  "t": "00:03:53",
  "text": "再把新的橡胶圈按照原位装回去"
 },
 {
  "t": "00:03:58",
  "text": "装完了以后记得在橡胶圈外侧都抹一点机油"
 },
 {
  "t": "00:04:01",
  "text": "上面还有机油 我就顺便撸一遍"
 },
 {
  "t": "00:04:03",
  "text": "这样子可以确保待会儿拧紧的时候"
 },
 {
  "t": "00:04:05",
  "text": "橡胶圈不会被扭得鼓起来"
 },
 {
  "t": "00:04:07",
  "text": "因为假设它扭得鼓起来的话 也会导致它漏油"
 },
 {
  "t": "00:04:09",
  "text": "接着很显然 我就需要把机滤给装回位"
 },
 {
  "t": "00:04:14",
  "text": "再把整个东西套回车上"
 },
 {
  "t": "00:04:19",
  "text": "最后再把盖子给拧紧"
 },
 {
  "t": "00:04:23",
  "text": "有条件的话最后换扭距扳手再确保一下扭距"
 },
 {
  "t": "00:04:26",
  "text": "我这辆车要拧到的是25Nm"
 },
 {
  "t": "00:04:28",
  "text": "但一般装机滤的时候"
 },
 {
  "t": "00:04:29",
  "text": "基本感觉手稍微有点拧紧的就够了"
 },
 {
  "t": "00:04:31",
  "text": "这个东西不需要拧太紧的"
 },
 {
  "t": "00:04:32",
  "text": "机滤换完"
 },
 {
  "t": "00:04:33",
  "text": "下面机油应该也漏得差不多干净了"
 },
 {
  "t": "00:04:35",
  "text": "我们现在就要把塞子给塞回去了"
 },
 {
  "t": "00:04:37",
  "text": "注意看螺栓上面是有一个铜的垫圈的"
 },
 {
  "t": "00:04:41",
  "text": "这个垫圈每次都要更换"
 },
 {
  "t": "00:04:42",
  "text": "因为它包装里都给了新的"
 },
 {
  "t": "00:04:44",
  "text": "机滤的包装里都给了新的"
 },
 {
  "t": "00:04:45",
  "text": "所以你没有不换的理由"
 },
 {
  "t": "00:04:47",
  "text": "我们把新的垫圈给套上这颗螺栓"
 },
 {
  "t": "00:04:49",
  "text": "然后就可以把整个塞子给拧回去了"
 },
 {
  "t": "00:04:52",
  "text": "这个铜垫圈同样也是一次性的"
 },
 {
  "t": "00:04:54",
  "text": "如果你不更换的话"
 },
 {
  "t": "00:04:55",
  "text": "以后这边就会漏油 弄得非常恶心"
 },
 {
  "t": "00:04:57",
  "text": "所以我们每次换机油的时候都要更换"
 },
 {
  "t": "00:04:59",
  "text": "铜垫圈在拧紧的过程中它会压变形"
 },
 {
  "t": "00:05:02",
  "text": "就把这边给彻底密封住了"
 },
 {
  "t": "00:05:04",
  "text": "这样我们车底下的部分就完成了"
 },
 {
  "t": "00:05:05",
  "text": "接着我们就可以准备加机油了"
 },
 {
  "t": "00:05:08",
  "text": "但是加机油前我会先把车重新落回地上"
 },
 {
  "t": "00:05:11",
  "text": "这样的话加完机油我们才可以检查机油的量是否正确"
 },
 {
  "t": "00:05:16",
  "text": "说到机油的量"
 },
 {
  "t": "00:05:17",
  "text": "你可以参考刚才放出来多少机油"
 },
 {
  "t": "00:05:19",
  "text": "如果你的桶上有刻度的话"
 },
 {
  "t": "00:05:20",
  "text": "你就知道你待会需要加多少机油"
 },
 {
  "t": "00:05:22",
  "text": "当然了更精确的方法还是参考你的保障手册"
 },
 {
  "t": "00:05:25",
  "text": "看一下每次换机油应该加多少量"
 },
 {
  "t": "00:05:27",
  "text": "我现在就往里面开始倒机油"
 },
 {
  "t": "00:05:30",
  "text": "刚开始的时候把机油罐反着倒"
 },
 {
  "t": "00:05:32",
  "text": "这样你不容易倒洒"
 },
 {
  "t": "00:05:36",
  "text": "根据机油桶上的刻度"
 },
 {
  "t": "00:05:37",
  "text": "我会先给它到5升左右"
 },
 {
  "t": "00:05:39",
  "text": "因为你不确定发动机里面还有没有机油的残留"
 },
 {
  "t": "00:05:42",
  "text": "看桶上这边的刻度就可以知道机油现在还剩多少"
 },
 {
  "t": "00:05:45",
  "text": "现在我先暂停一下"
 },
 {
  "t": "00:05:46",
  "text": "需要检查一下机油的刻度"
 },
 {
  "t": "00:05:48",
  "text": "因为你万一加多了要再放出来就比较麻烦了"
 },
 {
  "t": "00:05:50",
  "text": "又得把车架起来了"
 },
 {
  "t": "00:05:51",
  "text": "另外就是这辆宝马没有机油尺"
 },
 {
  "t": "00:05:53",
  "text": "所以必须要打了火以后才能在车里面看机油的刻度"
 },
 {
  "t": "00:05:56",
  "text": "这要注意的是"
 },
 {
  "t": "00:05:57",
  "text": "不管你是用什么方式看刻度"
 },
 {
  "t": "00:05:59",
  "text": "你的车一打火了以后"
 },
 {
  "t": "00:06:00",
  "text": "刚才空的机油滤芯里面会吸个大概半升的油"
 },
 {
  "t": "00:06:04",
  "text": "所以液面还是会往下降一点的"
 },
 {
  "t": "00:06:06",
  "text": "如果你在打火之前"
 },
 {
  "t": "00:06:07",
  "text": "机油尺抽出来感觉机油多加了那么一点点"
 },
 {
  "t": "00:06:09",
  "text": "那没关系 你一打火它就会下去"
 },
 {
  "t": "00:06:11",
  "text": "所以不要太担心"
 },
 {
  "t": "00:06:12",
  "text": "这里我插入钥匙打火"
 },
 {
  "t": "00:06:18",
  "text": "我用车里这边的功能往下翻"
 },
 {
  "t": "00:06:20",
  "text": "这边有个“OIL”点击进入"
 },
 {
  "t": "00:06:22",
  "text": "稍微等一下 马上就可以显示机油的量"
 },
 {
  "t": "00:06:26",
  "text": "这里机油的量显示在两个点之间"
 },
 {
  "t": "00:06:29",
  "text": "而且是在上沿"
 },
 {
  "t": "00:06:30",
  "text": "那我就知道我的机油量加得是正好的"
 },
 {
  "t": "00:06:32",
  "text": "这样我再点击OK就可以了"
 },
 {
  "t": "00:06:35",
  "text": "机油尺的测试方法同样也是一样的"
 },
 {
  "t": "00:06:36",
  "text": "在最高点和最低点之间就可以了"
 },
 {
  "t": "00:06:39",
  "text": "假设你机油还差一点"
 },
 {
  "t": "00:06:40",
  "text": "现在还可以再添加一点"
 },
 {
  "t": "00:06:41",
  "text": "添加完了以后再看油尺的高度"
 },
 {
  "t": "00:06:43",
  "text": "只要最后保持在最高点和最低点之间就可以了"
 },
 {
  "t": "00:06:45",
  "text": "这里我可以用刹车清洁剂"
 },
 {
  "t": "00:06:47",
  "text": "把刚才粘的机油全部稍微清洗一下"
 },
 {
  "t": "00:06:50",
  "text": "这样的话会显得干净一点"
 },
 {
  "t": "00:06:52",
  "text": "过几秒钟它就会开始干"
 },
 {
  "t": "00:06:53",
  "text": "刹车清洁剂干起来是非常快的"
 },
 {
  "t": "00:06:55",
  "text": "这样子的我们机油就算换完了"
 },
 {
  "t": "00:06:57",
  "text": "换下来的机油都可以倒到空的机油桶中"
 },
 {
  "t": "00:07:00",
  "text": "垃圾站或者卖机油的零售商都可以回收"
 },
 {
  "t": "00:07:03",
  "text": "就是你买机油的店门口一般都可以免费回收"
 },
 {
  "t": "00:07:06",
  "text": "不要把旧的机油倒到下水道里"
 },
 {
  "t": "00:07:07",
  "text": "机油会影响周围河道的环境"
 },
 {
  "t": "00:07:09",
  "text": "另外这里我快速讲一下怎么重置宝马保养的提示灯"
 },
 {
  "t": "00:07:13",
  "text": "这里我们先把车钥匙插进去 但是不要启动车"
 },
 {
  "t": "00:07:16",
  "text": "也就是不要踩离合或者踩刹车"
 },
 {
  "t": "00:07:17",
  "text": "按一下启动键"
 },
 {
  "t": "00:07:19",
  "text": "这个时候按住左侧平时你重置里程表的键"
 },
 {
  "t": "00:07:22",
  "text": "按住"
 },
 {
  "t": "00:07:27",
  "text": "然后这上面会显示你现在保养的情况"
 },
 {
  "t": "00:07:30",
  "text": "这个是机油"
 },
 {
  "t": "00:07:31",
  "text": "我们掰左侧这个上下"
 },
 {
  "t": "00:07:33",
  "text": "可以调整你需要选择的项目"
 },
 {
  "t": "00:07:36",
  "text": "这里我们换了机油"
 },
 {
  "t": "00:07:37",
  "text": "我就把机油的这个给重置"
 },
 {
  "t": "00:07:39",
  "text": "调到机油这个以后"
 },
 {
  "t": "00:07:40",
  "text": "按一下边上这个键"
 },
 {
  "t": "00:07:41",
  "text": "它会问你要不要重置"
 },
 {
  "t": "00:07:43",
  "text": "然后再按住这个键"
 },
 {
  "t": "00:07:47",
  "text": "稍等一下 你看这个就重置完了"
 },
 {
  "t": "00:07:50",
  "text": "最后再谈一下大家可能感兴趣或者有用的信息"
 },
 {
  "t": "00:07:52",
  "text": "我这次用的是嘉士多绿桶的这款机油"
 },
 {
  "t": "00:07:55",
  "text": "我这个是很早以前买的"
 },
 {
  "t": "00:07:56",
  "text": "所以上面已经有灰了"
 },
 {
  "t": "00:07:57",
  "text": "我每次买机油的时候都是等店家半价的时候"
 },
 {
  "t": "00:08:00",
  "text": "因为就像这种机油经常是半价"
 },
 {
  "t": "00:08:01",
  "text": "原价可能$60~70几(澳元)"
 },
 {
  "t": "00:08:03",
  "text": "一半价就是$30几(澳元)"
 },
 {
  "t": "00:08:04",
  "text": "甚至最便宜的时候$22(澳元)一桶都是有的"
 },
 {
  "t": "00:08:07",
  "text": "而且像Supercheap这种店是经常半价"
 },
 {
  "t": "00:08:09",
  "text": "基本一年里有半年时间是半价"
 },
 {
  "t": "00:08:11",
  "text": "比如假设现在不半价"
 },
 {
  "t": "00:08:12",
  "text": "但搞不好下周就开始半价"
 },
 {
  "t": "00:08:14",
  "text": "一半价就半价两个月"
 },
 {
  "t": "00:08:15",
  "text": "所以你趁这种时候买"
 },
 {
  "t": "00:08:16",
  "text": "就可以买到比较便宜的机油"
 },
 {
  "t": "00:08:17",
  "text": "另外现在嘉实多绿桶的都换了全合成的配方了"
 },
 {
  "t": "00:08:21",
  "text": "有些人非常在意买机油必须要买全合成的"
 },
 {
  "t": "00:08:23",
  "text": "我自己是非常不在意这个的"
 },
 {
  "t": "00:08:25",
  "text": "半合成的就可以了"
 },
 {
  "t": "00:08:26",
  "text": "假设全合成机油价格贵了一倍"
 },
 {
  "t": "00:08:28",
  "text": "那它也不代表你可以跳过一次保养"
 },
 {
  "t": "00:08:30",
  "text": "因为你每次保养你还是得换机滤嘛"
 },
 {
  "t": "00:08:32",
  "text": "你换机滤的时候顺便就把机油一起换了"
 },
 {
  "t": "00:08:34",
  "text": "说实话我们每1万公里或者每一年做保养的人"
 },
 {
  "t": "00:08:36",
  "text": "全合成跟半合成是感觉不到任何区别的"
 },
 {
  "t": "00:08:38",
  "text": "也不会对你车有任何影响"
 },
 {
  "t": "00:08:40",
  "text": "有半合成符合你车规格的 你买便宜的就行了"
 },
 {
  "t": "00:08:42",
  "text": "但也有些人就非不肯做保养"
 },
 {
  "t": "00:08:44",
  "text": "开2万公里还不换机油"
 },
 {
  "t": "00:08:45",
  "text": "你说用全合成的可能有一点点帮助"
 },
 {
  "t": "00:08:47",
  "text": "但是你这样不做保养"
 },
 {
  "t": "00:08:48",
  "text": "对车的伤害其实是非常大的"
 },
 {
  "t": "00:08:50",
  "text": "没有人会建议你用了全合成就可以跳过一次保养"
 },
 {
  "t": "00:08:52",
  "text": "如果你就觉得费钱的话 你就用半合成的"
 },
 {
  "t": "00:08:54",
  "text": "你勤快一点做保养"
 },
 {
  "t": "00:08:56",
  "text": "其实反而对你的车要好很多"
 },
 {
  "t": "00:08:57",
  "text": "现在嘉实多全线产品都已经变全合成了"
 },
 {
  "t": "00:09:00",
  "text": "所以它也算是个升级了"
 },
 {
  "t": "00:09:01",
  "text": "那我也不介意用更好的"
 },
 {
  "t": "00:09:02",
  "text": "所以这次就买了嘉实多的这款机油"
 },
 {
  "t": "00:09:05",
  "text": "那有人会想为什么要自己做保养"
 },
 {
  "t": "00:09:07",
  "text": "去修车店里也能做"
 },
 {
  "t": "00:09:08",
  "text": "其实从我自己的角度出发"
 },
 {
  "t": "00:09:09",
  "text": "我觉得你自己做保养的时候"
 },
 {
  "t": "00:09:11",
  "text": "每次加的机油的量 加的机油的型号"
 },
 {
  "t": "00:09:13",
  "text": "换机滤的时候有没有装好"
 },
 {
  "t": "00:09:14",
  "text": "你这都可以自己控制"
 },
 {
  "t": "00:09:16",
  "text": "你去修车厂的时候 尤其是大的修车厂"
 },
 {
  "t": "00:09:18",
  "text": "4s店尤其是这样"
 },
 {
  "t": "00:09:19",
  "text": "很可能没给你机滤的橡胶垫圈装好"
 },
 {
  "t": "00:09:21",
  "text": "对你车的寿命总是有点影响的"
 },
 {
  "t": "00:09:23",
  "text": "你自己做可以百分百确定你把这些活都干好"
 },
 {
  "t": "00:09:26",
  "text": "你又不是店里一天要做几百个车"
 },
 {
  "t": "00:09:27",
  "text": "你多花一分钟时间再检查一遍"
 },
 {
  "t": "00:09:29",
  "text": "总会比修学厂里弄得好"
 },
 {
  "t": "00:09:30",
  "text": "而且可以看到像这样子换机油的整个流程"
 },
 {
  "t": "00:09:33",
  "text": "也就5分钟的时间"
 },
 {
  "t": "00:09:34",
  "text": "我这边太阳落山以后天黑之前"
 },
 {
  "t": "00:09:36",
  "text": "连着拍视频讲解也就十几分钟做完了"
 },
 {
  "t": "00:09:38",
  "text": "其实反而要比你把车开到修车厂里"
 },
 {
  "t": "00:09:41",
  "text": "等它排队做完保养再把车取出来"
 },
 {
  "t": "00:09:43",
  "text": "这个时间要短很多"
 },
 {
  "t": "00:09:44",
  "text": "所以自己做保养"
 },
 {
  "t": "00:09:45",
  "text": "不仅是省了钱 保证了质量"
 },
 {
  "t": "00:09:47",
  "text": "更重要的其实是省了你自己的时间"
 },
 {
  "t": "00:09:49",
  "text": "好了 现在外面我这边天也黑了"
 },
 {
  "t": "00:09:51",
  "text": "我就不再多讲了"
 },
 {
  "t": "00:09:52",
  "text": "如果你觉得今天视频有帮助的话"
 },
 {
  "t": "00:09:53",
  "text": "记得在下面帮我点赞支持一下"
 },
 {
  "t": "00:09:55",
  "text": "如果想了解其他汽车保养的内容"
 },
 {
  "t": "00:09:57",
  "text": "可以点击下方进入我的YouTube频道"
 },
 {
  "t": "00:09:58",
  "text": "我有从更换变速箱 油刹车油"
 },
 {
  "t": "00:10:00",
  "text": "甚至到自己组装差速器等"
 },
 {
  "t": "00:10:02",
  "text": "覆盖各个难度的汽车保养和维修视频"
 },
 {
  "t": "00:10:05",
  "text": "那本期视频就到这边"
 },
 {
  "t": "00:10:06",
  "text": "我是Kendi"
 },
 {
  "t": "00:10:07",
  "text": "我们下期再见"
 }
]