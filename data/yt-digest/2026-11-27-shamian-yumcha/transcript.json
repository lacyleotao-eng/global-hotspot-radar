 },
 {
  "t": "00:30:39",
  "text": "後來不就變了英法租界"
 },
 {
  "t": "00:30:40",
  "text": "就被人拆了啦，推下海"
 },
 {
  "t": "00:30:43",
  "text": "是啊，都很有歷史價值的，這兩支炮都"
 },
 {
  "t": "00:30:47",
  "text": "這裡就是它的介紹了"
 },
 {
  "t": "00:30:49",
  "text": "黃先生，你坐好"
 },
 {
  "t": "00:30:52",
  "text": "小心摔下去啊"
 },
 {
  "t": "00:30:55",
  "text": "以前我整天都在這裡玩的"
 },
 {
  "t": "00:30:59",
  "text": "怎麼會摔得下去啊"
 },
 {
  "t": "00:31:00",
  "text": "你有沒有在那裡摸石螺啊"
 },
 {
  "t": "00:31:03",
  "text": "又沒摸過石螺"
 },
 {
  "t": "00:31:04",
  "text": "就坐在這裡而已"
 },
 {
  "t": "00:31:07",
  "text": "是有點危險的，大家不要不要這樣坐啊"
 },
 {
  "t": "00:31:10",
  "text": "你現在坐在這裡有沒有想起些"
 },
 {
  "t": "00:31:12",
  "text": "童年往事這樣呢"
 },
 {
  "t": "00:31:14",
  "text": "我記得好像是沒這麼多圍欄的以前"
 },
 {
  "t": "00:31:17",
  "text": "你簡直都可以去到這個誒誒這個呢"
 },
 {
  "t": "00:31:21",
  "text": "個江邊這裡的"
 },
 {
  "t": "00:31:23",
  "text": "這裡沒有攔住的，以前"
 },
 {
  "t": "00:31:24",
  "text": "是吧"
 },
 {
  "t": "00:31:25",
  "text": "可以下去游泳嘛"
 },
 {
  "t": "00:31:27",
  "text": "嗯"
 },
 {
  "t": "00:31:28",
  "text": "以前在岸邊游泳就是從這裡下去的"
 },
 {
  "t": "00:31:30",
  "text": "就是這個石階嘛"
 },
 {
  "t": "00:31:33",
  "text": "現在不讓游了"
 },
 {
  "t": "00:31:35",
  "text": "所以它現在都弄些護欄攔住它"
 },
 {
  "t": "00:31:38",
  "text": "不讓你游啊，還要弄兩句說話在那裡"
 },
 {
  "t": "00:31:40",
  "text": "是啊，但是你有沒有見到"
 },
 {
  "t": "00:31:43",
  "text": "真的有人在那裡游泳"
 },
 {
  "t": "00:31:46",
  "text": "他背著那個不是水泡來的"
 },
 {
  "t": "00:31:48",
  "text": "蠔油罐來的"
 },
 {
  "t": "00:31:49",
  "text": "哇，如果我爸看到啊，興奮啊這些"
 },
 {
  "t": "00:31:52",
  "text": "他以前是不是就在沙面游泳嘛"
 },
 {
  "t": "00:31:55",
  "text": "為什麼整天來沙面呢"
 },
 {
  "t": "00:31:56",
  "text": "哦，喜歡來這些嘛"
 },
 {
  "t": "00:31:58",
  "text": "你聞不聞到那些江風味，很香啊"
 },
 {
  "t": "00:32:00",
  "text": "我聞到啊"
 },
 {
  "t": "00:32:04",
  "text": "這棵榕樹啊，二百三十五年啊"
 },
 {
  "t": "00:32:07",
  "text": "怪不得你說超過一百年、百幾年啊"
 },
 {
  "t": "00:32:11",
  "text": "它隨隨便便的，你不發覺的"
 },
 {
  "t": "00:32:13",
  "text": "是啊"
 },
 {
  "t": "00:32:14",
  "text": "那藏在些花基旁邊這樣又"
 },
 {
  "t": "00:32:16",
  "text": "二百來年啊又"
 },
 {
  "t": "00:32:17",
  "text": "是啊"
 },
 {
  "t": "00:32:23",
  "text": "沙面很大的"
 },
 {
  "t": "00:32:24",
  "text": "有很多值得我們遊覽的景點和勾起我"
 },
 {
  "t": "00:32:27",
  "text": "們回憶的事情"
 },
 {
  "t": "00:32:29",
  "text": "之後我們會在另一集詳細跟大家介紹"
 },
 {
  "t": "00:32:33",
  "text": "這棟紅色建築"
 },
 {
  "t": "00:32:34",
  "text": "1907年的時候就已經建了"
 },
 {
  "t": "00:32:36",
  "text": "以前就是粵海關俱樂部的舊址啊"
 },
 {
  "t": "00:32:40",
  "text": "德兵營舊址旁邊就是路德聖母堂啊"
 },
 {
  "t": "00:32:44",
  "text": "那以前就是給人們在那裡參拜"
 },
 {
  "t": "00:32:49",
  "text": "禮拜"
 },
 {
  "t": "00:32:49",
  "text": "嗯，禮拜的"
 },
 {
  "t": "00:32:51",
  "text": "過了東橋進來就見到這棟"
 },
 {
  "t": "00:32:54",
  "text": "白色的建築啊"
 },
 {
  "t": "00:32:56",
  "text": "當時這裡是法國的巡捕房來的"
 },
 {
  "t": "00:33:02",
  "text": "哇，這個哪個明星啊"
 },
 {
  "t": "00:33:03",
  "text": "長槍短炮全部都對著他的"
 },
 {
  "t": "00:33:05",
  "text": "是啊"
 },
 {
  "t": "00:33:08",
  "text": "厲害，這裡"
 },
 {
  "t": "00:33:08",
  "text": "其實就是讓一個小朋友啊站下來"
 },
 {
  "t": "00:33:11",
  "text": "然後就可以跟他搭著個肩膀"
 },
 {
  "t": "00:33:14",
  "text": "跟著這個小朋友呢"
 },
 {
  "t": "00:33:15",
  "text": "就扶著他這樣的"
 },
 {
  "t": "00:33:18",
  "text": "吃抵的話，吃這個味我覺得更划算"
 },
 {
  "t": "00:33:21",
  "text": "嗯"
 },
 {
  "t": "00:33:22",
  "text": "是啊"
 },
 {
  "t": "00:33:23",
  "text": "各位觀眾朋友"
 },
 {
  "t": "00:33:25",
  "text": "看完視頻記得在評論區留下你的看法"
 },
 {
  "t": "00:33:28",
  "text": "每一條留言我們都會認真看"
 },
 {
  "t": "00:33:31",
  "text": "逐個回覆的"
 },
 {
  "t": "00:33:32",
  "text": "我們期待跟大家一起聊一下天"
 },
 {
  "t": "00:33:35",
  "text": "謝謝你們的支持"
 }
]