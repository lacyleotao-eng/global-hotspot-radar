[
 {
  "t": "00:00:00",
  "text": "大家有多久沒來過沙面喝茶啊"
 },
 {
  "t": "00:00:14",
  "text": "現在就叫廣東勝利賓館啦"
 },
 {
  "t": "00:00:16",
  "text": "那以前就叫維多利亞酒店"
 },
 {
  "t": "00:00:19",
  "text": "原來勝利賓館這裡有這麼大"
 },
 {
  "t": "00:00:21",
  "text": "的博物館的"
 },
 {
  "t": "00:00:22",
  "text": "小時候我又熟悉，那些煤油燈又熟悉"
 },
 {
  "t": "00:00:25",
  "text": "那些提著的，是吧"
 },
 {
  "t": "00:00:26",
  "text": "是啊"
 },
 {
  "t": "00:00:27",
  "text": "你不要說為什麼要這麼早啊"
 },
 {
  "t": "00:00:29",
  "text": "好位置要早點來才佔得到嘛"
 },
 {
  "t": "00:00:32",
  "text": "這麼多種蛋撻呢"
 },
 {
  "t": "00:00:33",
  "text": "其實我最喜歡都是吃傳統蛋撻"
 },
 {
  "t": "00:00:36",
  "text": "啊，以前呢"
 },
 {
  "t": "00:00:37",
  "text": "就說這裡有塊牌子"
 },
 {
  "t": "00:00:39",
  "text": "寫著華人與狗不得入內的"
 },
 {
  "t": "00:00:41",
  "text": "究竟有沒有這塊牌子呢"
 },
 {
  "t": "00:00:43",
  "text": "今天我們在沙面喝茶"
 },
 {
  "t": "00:00:45",
  "text": "點了六樣東西才一百來塊錢而已"
 },
 {
  "t": "00:00:47",
  "text": "好像說以前這裡附近有個叫做"
 },
 {
  "t": "00:00:50",
  "text": "綠瓦亭的地方"
 },
 {
  "t": "00:00:52",
  "text": "白鵝潭那邊嘛"
 },
 {
  "t": "00:00:53",
  "text": "那邊就是六二三路啦"
 },
 {
  "t": "00:00:55",
  "text": "這個就是沙面泳場啦"
 },
 {
  "t": "00:00:58",
  "text": "我們以前小時候整天都坐在沙邊"
 },
 {
  "t": "00:01:00",
  "text": "岸邊那裡玩的"
 },
 {
  "t": "00:01:01",
  "text": "以前在沙邊游泳就是從這裡下去的"
 },
 {
  "t": "00:01:04",
  "text": "看"
 },
 {
  "t": "00:01:04",
  "text": "大家有沒有來過白天鵝賓館的故鄉水"
 },
 {
  "t": "00:01:07",
  "text": "這裡打過卡啊"
 },
 {
  "t": "00:01:09",
  "text": "就是說離開家鄉"
 },
 {
  "t": "00:01:10",
  "text": "哪有一天不掛念的"
 },
 {
  "t": "00:01:20",
  "text": "各位觀眾大家好啊"
 },
 {
  "t": "00:01:22",
  "text": "今天我準備跟黃先生穿過這條橋"
 },
 {
  "t": "00:01:24",
  "text": "到沙面的勝利賓館喝早茶"
 },
 {
  "t": "00:01:27",
  "text": "大家過來這裡可以坐地鐵1號線"
 },
 {
  "t": "00:01:30",
  "text": "或者6號線的"
 },
 {
  "t": "00:01:31",
  "text": "出了閘之後沿著F出口走"
 },
 {
  "t": "00:01:35",
  "text": "說起沙面我們都有很多回憶的"
 },
 {
  "t": "00:01:37",
  "text": "一會兒我跟黃先生一邊喝茶一邊聊一下"
 },
 {
  "t": "00:01:41",
  "text": "要幾分鐘呢"
 },
 {
  "t": "00:01:42",
  "text": "才走到勝利賓館那裡的"
 },
 {
  "t": "00:01:44",
  "text": "嗯，是啊"
 },
 {
  "t": "00:01:44",
  "text": "那我們聊幾句吧"
 },
 {
  "t": "00:01:46",
  "text": "那其實沙面呢"
 },
 {
  "t": "00:01:47",
  "text": "就是我爸媽啊"
 },
 {
  "t": "00:01:48",
  "text": "嗯"
 },
 {
  "t": "00:01:49",
  "text": "都很喜歡來沙面玩的"
 },
 {
  "t": "00:01:51",
  "text": "他小時候那個時候"
 },
 {
  "t": "00:01:52",
  "text": "到我們呢，其實就是去六二三路啊"
 },
 {
  "t": "00:01:55",
  "text": "長堤那邊也比較多"
 },
 {
  "t": "00:01:57",
  "text": "當然啦"
 },
 {
  "t": "00:01:57",
  "text": "啊"
 },
 {
  "t": "00:01:58",
  "text": "蝦媽上街都是去南方大廈那邊的"
 },
 {
  "t": "00:02:02",
  "text": "包括文化宮，多些東西玩嘛"
 },
 {
  "t": "00:02:04",
  "text": "是啊"
 },
 {
  "t": "00:02:05",
  "text": "那後來長大了"
 },
 {
  "t": "00:02:06",
  "text": "了解沙面多一些之後才來沙面多了"
 },
 {
  "t": "00:02:10",
  "text": "嗯"
 },
 {
  "t": "00:02:13",
  "text": "一走下橋之後"
 },
 {
  "t": "00:02:15",
  "text": "那些建築就已經特別不一樣了"
 },
 {
  "t": "00:02:18",
  "text": "西洋建築啊"
 },
 {
  "t": "00:02:19",
  "text": "嗯"
 },
 {
  "t": "00:02:20",
  "text": "這棟樓以前好像是印度人住在那裡的"
 },
 {
  "t": "00:02:24",
  "text": "以前這裡不是有很多印度警察的"
 },
 {
  "t": "00:02:25",
  "text": "在那裡做事"
 },
 {
  "t": "00:02:26",
  "text": "因為這裡是英法租界嘛"
 },
 {
  "t": "00:02:27",
  "text": "嗯"
 },
 {
  "t": "00:02:28",
  "text": "它其實外牆都翻新過的啦"
 },
 {
  "t": "00:02:31",
  "text": "啊"
 },
 {
  "t": "00:02:31",
  "text": "但是整棟樓都是"
 },
 {
  "t": "00:02:33",
  "text": "結構都差不多"
 },
 {
  "t": "00:02:34",
  "text": "恢復以前的原貌"
 },
 {
  "t": "00:02:36",
  "text": "是啊，但是你有沒有看到那些窗"
 },
 {
  "t": "00:02:38",
  "text": "都是我們那些嶺南的百葉窗來的"
 },
 {
  "t": "00:02:41",
  "text": "是啊"
 },
 {
  "t": "00:02:42",
  "text": "通風嘛，這裡潮濕嘛"
 },
 {
  "t": "00:02:43",
  "text": "嗯"
 },
 {
  "t": "00:02:44",
  "text": "這幾天我聽說北方下雪了"
 },
 {
  "t": "00:02:47",
  "text": "是啊"
 },
 {
  "t": "00:02:48",
  "text": "但是你看我們廣州"
 },
 {
  "t": "00:02:49",
  "text": "其實我們廣州已經入秋了"
 },
 {
  "t": "00:02:52",
  "text": "綠油油，是綠油油嘛"
 },
 {
  "t": "00:02:53",
  "text": "是啊，廣州呢"
 },
 {
  "t": "00:02:54",
  "text": "如果你要見到滿地都是樹葉"
 },
 {
  "t": "00:02:57",
  "text": "就要明年的四五月它才，哈哈哈"
 },
 {
  "t": "00:03:00",
  "text": "它才換葉。現在你秋天呢"
 },
 {
  "t": "00:03:02",
  "text": "那些樹就是綠油油的，你看一下"
 },
 {
  "t": "00:03:05",
  "text": "嗯"
 },
 {
  "t": "00:03:05",
  "text": "一進來真的，如果是熱天的話都是"
 },
 {
  "t": "00:03:08",
  "text": "降低幾度溫度的，真的"
 },
 {
  "t": "00:03:09",
  "text": "是啊，因為這裡整條路都是樹嘛"
 },
 {
  "t": "00:03:11",
  "text": "你整個都是陰涼的"
 },
 {
  "t": "00:03:12",
  "text": "我們一路走呢"
 },
 {
  "t": "00:03:14",
  "text": "旁邊這裡就是沙基湧啦"
 },
 {
  "t": "00:03:17",
  "text": "唉，以前這裡很多艇仔啊"
 },
 {
  "t": "00:03:20",
  "text": "是啊，以前就在那裡吃艇仔粥嘛"
 },
 {
  "t": "00:03:22",
  "text": "就下石階下去的嘛"
 },
 {
  "t": "00:03:24",
  "text": "啊"
 },
 {
  "t": "00:03:25",
  "text": "現在很乾淨啊"
 },
 {
  "t": "00:03:26",
  "text": "就全弄了護欄啦，沒有艇仔粥吃了"
 },
 {
  "t": "00:03:30",
  "text": "雖然沙面有很多西洋建築啊"
 },
 {
  "t": "00:03:33",
  "text": "但是在我心目中最有印象的都"
 },
 {
  "t": "00:03:37",
  "text": "是游泳館啊、網球場啊"
 },
 {
  "t": "00:03:40",
  "text": "沙面公園這些地方"
 },
 {
  "t": "00:03:42",
  "text": "我們玩的嘛"
 },
 {
  "t": "00:03:43",
  "text": "是啊"
 },
 {
  "t": "00:03:45",
  "text": "沙面以前好像叫做拾翠洲的"
 },
 {
  "t": "00:03:49",
  "text": "是啊，我來拋拋書包啦，黃太"
 },
 {
  "t": "00:03:51",
  "text": "那其實我查過資料"
 },
 {
  "t": "00:03:53",
  "text": "就是清朝同治年間啊哈，1872年"
 },
 {
  "t": "00:03:58",
  "text": "南海縣志記載啊，寫著啊"
 },
 {
  "t": "00:04:00",
  "text": "中流沙，拾翠洲"
 },
 {
  "t": "00:04:03",
  "text": "哦，所以現在沙面那裡都有個社區叫做"
 },
 {
  "t": "00:04:07",
  "text": "翠洲社區"
 },
 {
  "t": "00:04:08",
  "text": "可能就是這個得名啦"
 },
 {
  "t": "00:04:09",
  "text": "嗯"
 },
 {
  "t": "00:04:10",
  "text": "過了這裡"
 },
 {
  "t": "00:04:12",
  "text": "這麼快就到西橋啦"
 },
 {
  "t": "00:04:14",
  "text": "嗯"
 },
 {
  "t": "00:04:14",
  "text": "前面就是了"
 },
 {
  "t": "00:04:16",
  "text": "我們快去拿位子吧"
 },
 {
  "t": "00:04:18",
  "text": "好啊"
 },
 {
  "t": "00:04:19",
  "text": "誒，早上很多人喝茶，拿位子呢"
 },
 {
  "t": "00:04:21",
  "text": "坐下來再一邊喝茶一邊跟大家聊啦"
 },
 {
  "t": "00:04:24",
  "text": "慢慢聊呵"
 },
 {
  "t": "00:04:25",
  "text": "嗯"
 },
 {
  "t": "00:04:25",
  "text": "前面就是勝利賓館了"
 },
 {
  "t": "00:04:29",
  "text": "這個勝利賓館啊，歷史悠久了"
 },
 {
  "t": "00:04:32",
  "text": "來拋拋書包啦，勝利賓館呢"
 },
 {
  "t": "00:04:35",
  "text": "前身就是英國人在1865年啊"
 },
 {
  "t": "00:04:39",
  "text": "在沙面建的一間英式酒店來的"
 },
 {
  "t": "00:04:42",
  "text": "嗯"
 },
 {
  "t": "00:04:42",
  "text": "就叫沙面酒店"
 },
 {
  "t": "00:04:44",
  "text": "嗯"
 },
 {
  "t": "00:04:45",
  "text": "那後來在1895年就更名為這個"
 },
 {
  "t": "00:04:48",
  "text": "維多利亞酒店這樣的"
 },
 {
  "t": "00:04:50",
  "text": "嗯"
 },
 {
  "t": "00:04:51",
  "text": "而現在看到的這個"
 },
 {
  "t": "00:04:53",
  "text": "應該是它93年重建的那個樣子了"
 },
 {
  "t": "00:04:58",
  "text": "現在就叫廣東勝利賓館啦"
 },
 {
  "t": "00:05:01",
  "text": "那以前就叫維多利亞酒店"
 },
 {
  "t": "00:05:04",
  "text": "其實維多利亞的英文不就是"
 },
 {
  "t": "00:05:08",
  "text": "那不就是勝利嘛"
 },
 {
  "t": "00:05:15",
  "text": "這個大堂都挺大呵"
 },
 {
  "t": "00:05:18",
  "text": "而且挺舒服的"
 },
 {
  "t": "00:05:22",
  "text": "哇"
 },
 {
  "t": "00:05:22",
  "text": "這個鐘沒有100都有幾十年歷史啊，這些"
 },
 {
  "t": "00:05:27",
  "text": "嗯"
 },
 {
  "t": "00:05:28",
  "text": "英式那些掛鐘啊"
 },
 {
  "t": "00:05:30",
  "text": "是啊"
 },
 {
  "t": "00:05:31",
  "text": "那勝利賓館還有博物館的"
 },
 {
  "t": "00:05:33",
  "text": "在那裡推門進去就是了"
 },
 {
  "t": "00:05:35",
  "text": "是啊"
 },
 {
  "t": "00:05:36",
  "text": "原來勝利賓館這裡有"
 },
 {
  "t": "00:05:37",
  "text": "這麼大的博物館的"
 },
 {
  "t": "00:05:39",
  "text": "這個我就很熟"
 },
 {
  "t": "00:05:40",
  "text": "船用航行燈啊"
 },
 {
  "t": "00:05:42",
  "text": "小時候我很熟悉，那些煤油燈啊，熟悉"
 },
 {
  "t": "00:05:45",
  "text": "那些提著的，是吧"
 },
 {
  "t": "00:05:46",
  "text": "是啊"
 },
 {
  "t": "00:05:47",
  "text": "哦"
 },
 {
  "t": "00:05:48",
  "text": "收音機"
 },
 {
  "t": "00:05:49",
  "text": "收音機，哇，以前有這部東西很厲害啊哈"
 },
 {
  "t": "00:05:52",
  "text": "木殼收音機啊"
 },
 {
  "t": "00:05:53",
  "text": "哇"
 },
 {
  "t": "00:05:55",
  "text": "這個是匯豐銀行舊址陽台柱啊"
 },
 {
  "t": "00:05:59",
  "text": "嗯，是啊"
 },
 {
  "t": "00:06:01",
  "text": "陽台那條柱啊"
 },
 {
  "t": "00:06:03",
  "text": "當時第45屆世界錦標賽就在這裡下榻"
 },
 {
  "t": "00:06:08",
  "text": "的"
 },
 {
  "t": "00:06:08",
  "text": "酒店"
 },
 {
  "t": "00:06:09",
  "text": "嗯"
 },
 {
  "t": "00:06:11",
  "text": "沙面以及六二三路的歷史呢"
 },
 {
  "t": "00:06:15",
  "text": "就是我們一直知道的就是主要是那"
 },
 {
  "t": "00:06:18",
  "text": "個六二三路的沙基慘案這件事"
 },
 {
  "t": "00:06:22",
  "text": "嗯"
 },
 {
  "t": "00:06:22",
  "text": "現在那裡都有個紀念碑啊"
 },
 {
  "t": "00:06:25",
  "text": "看一下勝利賓館的價錢吧"
 },
 {
  "t": "00:06:28",
  "text": "其實都不貴的，828塊兩晚啊"
 },
 {
  "t": "00:06:32",
  "text": "一晚就是466塊起"
 },
 {
  "t": "00:06:35",
  "text": "都是4000塊啦"
 },
 {
  "t": "00:06:37",
  "text": "4000塊可以啊"
 },
 {
  "t": "00:06:38",
  "text": "是啊，5000塊"
 },
 {
  "t": "00:06:40",
  "text": "那個房間就有窗的"
 },
 {
  "t": "00:06:42",
  "text": "是啊"
 },
 {
  "t": "00:06:44",
  "text": "不要看啦，我們我們先去拿位子"
 },
 {
  "t": "00:06:46",
  "text": "你走得這麼急做什麼呢"
 },
 {
  "t": "00:06:48",
  "text": "我想著就拿對著沙基湧那個好位子嘛"
 },
 {
  "t": "00:06:52",
  "text": "嘛"
 },
 {
  "t": "00:06:53",
  "text": "怎麼不開呢，都拉上閘了啊"
 },
 {
  "t": "00:06:56",
  "text": "幾點鐘啊"
 },
 {
  "t": "00:06:58",
  "text": "你看一下人家的營業時間啊"
 },
 {
  "t": "00:07:01",
  "text": "寫著早上8點半開始的"
 },
 {
  "t": "00:07:04",
  "text": "這裡是國家級的五鑽酒家來的"
 },
 {
  "t": "00:07:13",
  "text": "一開了門我們就馬上走上來啊"
 },
 {
  "t": "00:07:16",
  "text": "輕輕鬆鬆啊"
 },
 {
  "t": "00:07:17",
  "text": "是啊"
 },
 {
  "t": "00:07:17",
  "text": "他霸第一個位啊"
 },
 {
  "t": "00:07:19",
  "text": "按道理來說呢"
 },
 {
  "t": "00:07:20",
  "text": "我就第一個上來的，現在就"
 },
 {
  "t": "00:07:22",
  "text": "嗯"
 },
 {
  "t": "00:07:29",
  "text": "今天早上我們一大早啊出來啊"
 },
 {
  "t": "00:07:31",
  "text": "那終於讓黃先生搞到這張桌子啦"
 },
 {
  "t": "00:07:36",
  "text": "窗邊位這裡總共有五張桌子的"
 },
 {
  "t": "00:07:39",
  "text": "那我們就看過了一下"
 },
 {
  "t": "00:07:41",
  "text": "就覺得這張桌子是相對比較好的"
 },
 {
  "t": "00:07:44",
  "text": "這張桌子的桌號是65號桌啊"
 },
 {
  "t": "00:07:56",
  "text": "外面是15塊的，就是兩邊一樣的，是吧"
 },
 {
  "t": "00:07:59",
  "text": "一樣一樣"
 },
 {
  "t": "00:08:00",
  "text": "哦，一樣"
 },
 {
  "t": "00:08:04",
  "text": "那這裡景漂亮多了"
 },
 {
  "t": "00:08:06",
  "text": "嗯，如果要看景就坐這邊"
 },
 {
  "t": "00:08:09",
  "text": "是啊"
 },
 {
  "t": "00:08:19",
  "text": "謝謝"
 },
 {
  "t": "00:08:20",
  "text": "好，謝謝"
 },
 {
  "t": "00:08:24",
  "text": "早上喝杯普洱啊"
 },
 {
  "t": "00:08:26",
  "text": "特別舒服啊，真的"
 },
 {
  "t": "00:08:27",
  "text": "嗯"
 },
 {
  "t": "00:08:28",
  "text": "旅遊區來的"
 },
 {
  "t": "00:08:29",
  "text": "嗯"
 },
 {
  "t": "00:08:29",
  "text": "一大早你看一下"
 },
 {
  "t": "00:08:32",
  "text": "他又看我我又看他啊，現在啊"
 },
 {
  "t": "00:08:34",
  "text": "哈哈哈"
 },
 {
  "t": "00:08:37",
  "text": "我們是不是沒見過大蛇拉屎"
 },
 {
  "t": "00:08:39",
  "text": "但是我見過呢"
 },
 {
  "t": "00:08:40",
  "text": "跟那些服務人員很熟那些老顧客啊"
 },
 {
  "t": "00:08:43",
  "text": "嗯"
 },
 {
  "t": "00:08:44",
  "text": "不不，坐這邊的"
 },
 {
  "t": "00:08:46",
  "text": "是啊，因為這裡啊"
 },
 {
  "t": "00:08:49",
  "text": "全部的桌子都是很小張的方形桌啦"
 },
 {
  "t": "00:08:53",
  "text": "那如果你說人多是坐不了的"
 },
 {
  "t": "00:08:55",
  "text": "最多是坐兩個人的"
 },
 {
  "t": "00:08:57",
  "text": "三個人呢就都很擠了，已經是"
 },
 {
  "t": "00:08:59",
  "text": "再加上這個位啊"
 },
 {
  "t": "00:09:01",
  "text": "如果出了太陽呢"
 },
 {
  "t": "00:09:03",
  "text": "很熱的，這裡曬過來的嘛"
 },
 {
  "t": "00:09:05",
  "text": "熱天不行"
 },
 {
  "t": "00:09:06",
  "text": "是啊"
 },
 {
  "t": "00:09:06",
  "text": "現在可以"
 },
 {
  "t": "00:09:07",
  "text": "其實很多如果常來喝茶的不會"
 },
 {
  "t": "00:09:11",
  "text": "喜歡坐這裡的"
 },
 {
  "t": "00:09:12",
  "text": "但是你說如果想過來拍照啊"
 },
 {
  "t": "00:09:14",
  "text": "拍視頻啊，那這個位就真的是一流"
 },
 {
  "t": "00:09:17",
  "text": "聊天也可以，這裡是安靜很多的"
 },
 {
  "t": "00:09:20",
  "text": "比較安靜啊"
 },
 {
  "t": "00:09:21",
  "text": "如果你喜歡熱鬧呢，可能外面好一些"
 },
 {
  "t": "00:09:23",
  "text": "嗯，是啊"
 },
 {
  "t": "00:09:28",
  "text": "哇，你看一下這個湖面啊，波光粼粼的"
 },
 {
  "t": "00:09:32",
  "text": "嗯"
 },
 {
  "t": "00:09:32",
  "text": "而且還有一位老伯伯啊"
 },
 {
  "t": "00:09:35",
  "text": "在那裡釣魚呢"
 },
 {
  "t": "00:09:37",
  "text": "真的很寫意啊"
 },
 {
  "t": "00:09:40",
  "text": "怎麼樣，你想不想釣一下魚啊"
 },
 {
  "t": "00:09:43",
  "text": "我首先要買套魚竿才行"
 },
 {
  "t": "00:09:45",
  "text": "你先學習一下釣魚吧"
 },
 {
  "t": "00:09:49",
  "text": "我看了一下餐牌"
 },
 {
  "t": "00:09:51",
  "text": "其實那些價錢都不算很平的"
 },
 {
  "t": "00:09:55",
  "text": "價錢這東西一向都不是勝利賓館的"
 },
 {
  "t": "00:09:57",
  "text": "優勢來的啦"
 },
 {
  "t": "00:09:59",
  "text": "是啊"
 },
 {
  "t": "00:10:00",
  "text": "而且你知不知道它是那個"
 },
 {
  "t": "00:10:02",
  "text": "白天鵝集團啊"
 },
 {
  "t": "00:10:04",
  "text": "嗯"
 },
 {
  "t": "00:10:04",
  "text": "旗下的四星級那個酒店來的"
 },
 {
  "t": "00:10:08",
  "text": "哦"
 },
 {
  "t": "00:10:09",
  "text": "那你怎麼會平啊"
 },
 {
  "t": "00:10:10",
  "text": "這個已經是相對於白天鵝平很多了"
 },
 {
  "t": "00:10:13",
  "text": "那也是"
 },
 {
  "t": "00:10:14",
  "text": "是吧"
 },
 {
  "t": "00:10:14",
  "text": "嗯"
 },
 {
  "t": "00:10:15",
  "text": "好像那個南街那個橋美那裡啊"
 },
 {
  "t": "00:10:18",
  "text": "嗯"
 },
 {
  "t": "00:10:18",
  "text": "喝茶一樣不便宜的"
 },
 {
  "t": "00:10:20",
  "text": "是啊"
 },
 {
  "t": "00:10:20",
  "text": "沙面喝茶不會便宜的"
 },
 {
  "t": "00:10:22",
  "text": "就是每一家都可能"
 },
 {
  "t": "00:10:24",
  "text": "有分高低的"
 },
 {
  "t": "00:10:25",
  "text": "但是好在在沙面喝茶那個意境好啊"
 },
 {
  "t": "00:10:29",
  "text": "嘛"
 },
 {
  "t": "00:10:30",
  "text": "心情一好嘛，景色又漂亮"
 },
 {
  "t": "00:10:32",
  "text": "是啊"
 },
 {
  "t": "00:10:35",
  "text": "它這裡喝茶價錢就貴一些"
 },
 {
  "t": "00:10:37",
  "text": "嗯"
 },
 {
  "t": "00:10:38",
  "text": "但是東西挺精緻的"
 },
 {
  "t": "00:10:40",
  "text": "好像這個啦，公道杯啦"
 },
 {
  "t": "00:10:43",
  "text": "還有個這麼精緻的茶壺啊"
 },
 {
  "t": "00:10:45",
  "text": "它跟這個茶杯呢"
 },
 {
  "t": "00:10:47",
  "text": "那些花紋是一套的"
 },
 {
  "t": "00:10:48",
  "text": "嗯"
 },
 {
  "t": "00:10:49",
  "text": "還有這些這麼漂亮的碗碗碟碟啊"
 },
 {
  "t": "00:10:52",
  "text": "還有這個茶架啦"
 },
 {
  "t": "00:10:54",
  "text": "以及這個燒水的"
 },
 {
  "t": "00:10:56",
  "text": "器皿啊，那還有一壺這個開水"
 },
 {
  "t": "00:11:00",
  "text": "不用你走過來"
 },
 {
  "t": "00:11:01",
  "text": "就是備著給你的"
 },
 {
  "t": "00:11:03",
  "text": "那你如果這邊的水不夠"
 },
 {
  "t": "00:11:05",
  "text": "就可以在這裡添下去了"
 },
 {
  "t": "00:11:06",
  "text": "我覺得是挺好的"
 },
 {
  "t": "00:11:08",
  "text": "我覺得喝茶的檔次啊"
 },
 {
  "t": "00:11:10",
  "text": "最重要體現在有沒有個茶托那裡啊"
 },
 {
  "t": "00:11:13",
  "text": "這個正合你了，你這麼愛咖啡"
 },
 {
  "t": "00:11:15",
  "text": "不用滴到周圍都是茶水啦"
 },
 {
  "t": "00:11:20",
  "text": "挺漂亮"
 },
 {
  "t": "00:11:21",
  "text": "這裡的營業時間是分三個時間段的"
 },
 {
  "t": "00:11:24",
  "text": "早茶、午市以及晚市啊"
 },
 {
  "t": "00:11:27",
  "text": "那如果好像我們今天早茶的話呢"
 },
 {
  "t": "00:11:29",
  "text": "就是八點半開始的"
 },
 {
  "t": "00:11:31",
  "text": "那點心就分五個價位的"
 },
 {
  "t": "00:11:34",
  "text": "最平就是19塊啦"
 },
 {
  "t": "00:11:35",
  "text": "最貴就是經典39塊的"
 },
 {
  "t": "00:11:39",
  "text": "茶位就15塊一位起啊"
 },
 {
  "t": "00:11:42",
  "text": "那如果是節假日就要收13%"
 },
 {
  "t": "00:11:45",
  "text": "的服務費"
 },
 {
  "t": "00:11:46",
  "text": "看了一下餐單"
 },
 {
  "t": "00:11:48",
  "text": "感覺它這裡的點心就會比其他地方會"
 },
 {
  "t": "00:11:51",
  "text": "稍微貴一點點，但是"
 },
 {
  "t": "00:11:54",
  "text": "它也有它的優點的"
 },
 {
  "t": "00:11:57",
  "text": "它每天啊都會有這個特價點心"
 },
 {
  "t": "00:12:00",
  "text": "每天一款的"
 },
 {
  "t": "00:12:02",
  "text": "那我覺得這個價錢也挺划算"
 },
 {
  "t": "00:12:04",
  "text": "16塊8一份"
 },
 {
  "t": "00:12:06",
  "text": "雖然說這裡是勝利賓館啊"
 },
 {
  "t": "00:12:08",
  "text": "那有些菜式就會偏貴的"
 },
 {
  "t": "00:12:11",
  "text": "有些菜式又挺實惠"
 },
 {
  "t": "00:12:13",
  "text": "好像這個燒鵝啦"
 },
 {
  "t": "00:12:15",
  "text": "都是88塊一份"
 },
 {
  "t": "00:12:28",
  "text": "那我現在見到平台上有個套餐啊"
 },
 {
  "t": "00:12:33",
  "text": "才158塊，這樣就有四款點心"
 },
 {
  "t": "00:12:38",
  "text": "然後還有一個菜"
 },
 {
  "t": "00:12:39",
  "text": "一個粥以及兩個茶位"
 },
 {
  "t": "00:12:42",
  "text": "好像這個划算一些"
 },
 {
  "t": "00:12:43",
  "text": "是啊，我覺得這個划算一些"
 },
 {
  "t": "00:12:45",
  "text": "你點心都多了一款啦"
 },
 {
  "t": "00:12:47",
  "text": "那你還有個粥以及有個菜呢"
 },
 {
  "t": "00:12:48",
  "text": "買這個啦"
 },
 {
  "t": "00:12:49",
  "text": "買這個套餐，是吧"
 },
 {
  "t": "00:12:51",
  "text": "是啊，到時候你回去啊"
 },
 {
  "t": "00:12:54",
  "text": "你吃不完啊你就打包嘛"
 },
 {
  "t": "00:12:56",
  "text": "啊，也是"
 },
 {
  "t": "00:12:56",
  "text": "你兒子都還沒起來啊，現在都"
 },
 {
  "t": "00:12:58",
  "text": "是啊"
 },
 {
  "t": "00:12:59",
  "text": "我們今天出來得比較早啊"
 },
 {
  "t": "00:13:01",
  "text": "七點多鐘我們就出來了"
 },
 {
  "t": "00:13:05",
  "text": "免得他買外賣啦"
 },
 {
  "t": "00:13:06",
  "text": "是啊"
 },
 {
  "t": "00:13:07",
  "text": "是吧，你在這裡吃起碼都好很多嘛"
 },
 {
  "t": "00:13:10",
  "text": "又健康一些啦"
 },
 {
  "t": "00:13:10",
  "text": "是啊"
 },
 {
  "t": "00:13:11",
  "text": "啊，原來那個沙面游泳場呢"
 },
 {
  "t": "00:13:13",
  "text": "就在這裡旁邊而已"
 },
 {
  "t": "00:13:16",
  "text": "就在北街那裡而已嘛"
 },
 {
  "t": "00:13:17",
  "text": "是啊"
 },
 {
  "t": "00:13:18",
  "text": "這個又蘊藏著歷史了"
 },
 {
  "t": "00:13:21",
  "text": "嗯"
 },
 {
  "t": "00:13:21",
  "text": "1887年就有了"
 },
 {
  "t": "00:13:23",
  "text": "這麼久啊"
 },
 {
  "t": "00:13:24",
  "text": "是啊，138年歷史"
 },
 {
  "t": "00:13:26",
  "text": "不過後來沒人游泳就養鯇魚"
 },
 {
  "t": "00:13:29",
  "text": "真的"
 },
 {
  "t": "00:13:30",
  "text": "是養兩年鯇魚"
 },
 {
  "t": "00:13:31",
  "text": "養鯇魚"
 },
 {
  "t": "00:13:32",
  "text": "是啊"
 },
 {
  "t": "00:13:33",
  "text": "它在廣州，四個主要的舊的"
 },
 {
  "t": "00:13:37",
  "text": "游泳場了"
 },
 {
  "t": "00:13:38",
  "text": "嗯"
 },
 {
  "t": "00:13:38",
  "text": "海國紅樓"
 },
 {
  "t": "00:13:40",
  "text": "誒，這個誒，珠江泳場"
 },
 {
  "t": "00:13:42",
  "text": "嗯"
 },
 {
  "t": "00:13:43",
  "text": "西郊泳場，那最早這個沙面了"
 },
 {
  "t": "00:13:45",
  "text": "嗯"
 },
 {
  "t": "00:13:47",
  "text": "好像你說它以前是用自來水的"
 },
 {
  "t": "00:13:50",
  "text": "是吧"
 },
 {
  "t": "00:13:51",
  "text": "它那裡有水廠嘛"
 },
 {
  "t": "00:13:52",
  "text": "其他戶外當然用珠江水啦"
 },
 {
  "t": "00:13:54",
  "text": "以前珠江水就跟現在珠江水不同"
 },
 {
  "t": "00:13:57",
  "text": "啊，當然不同啦，是不是這樣說"
 },
 {
  "t": "00:13:59",
  "text": "是啊"
 },
 {
  "t": "00:14:00",
  "text": "一百幾十年前的話就是"
 },
 {
  "t": "00:14:02",
  "text": "所以以前人們說在這裡游泳呢"
 },
 {
  "t": "00:14:05",
  "text": "就很了不起啊"
 },
 {
  "t": "00:14:06",
  "text": "那真的很了不起"
 },
 {
  "t": "00:14:07",
  "text": "是啊，只能看，就是叫什麼呢，人家說的叫"
 },
 {
  "t": "00:14:11",
  "text": "疍家雞見水啊，只能看"
 },
 {
  "t": "00:14:14",
  "text": "哈哈，這麼經典啊"
 },
 {
  "t": "00:14:16",
  "text": "我們點的套餐就已經上來了"
 },
 {
  "t": "00:14:18",
  "text": "我們要了排骨、鳳爪、蛋撻以及蘿蔔糕"
 },
 {
  "t": "00:14:22",
  "text": "那這個石螺粥跟生菜就是固定的"
 },
 {
  "t": "00:14:26",
  "text": "這個蘿蔔糕都挺香的"
 },
 {
  "t": "00:14:30",
  "text": "聞到很香的蘿蔔糕味啊"
 },
 {
  "t": "00:14:32",
  "text": "那它兩邊也煎得夠焦的"
 },
 {
  "t": "00:14:37",
  "text": "金黃金黃這樣的"
 },
 {
  "t": "00:14:40",
  "text": "它又不會鬆散"
 },
 {
  "t": "00:14:48",
  "text": "裡面有些蝦米啦"
 },
 {
  "t": "00:14:51",
  "text": "有些臘肉啦"
 },
 {
  "t": "00:14:53",
  "text": "也見到些蘿蔔粒啊，料都算可以的"
 },
 {
  "t": "00:14:57",
  "text": "也不會很硬"
 },
 {
  "t": "00:14:59",
  "text": "吃蘿蔔糕呢我最喜歡蘸些辣醬啊"
 },
 {
  "t": "00:15:02",
  "text": "它那辣醬看上去好像不錯"
 },
 {
  "t": "00:15:06",
  "text": "嗯，味道挺好啊"
 },
 {
  "t": "00:15:08",
  "text": "這辣醬不會太辣"
 },
 {
  "t": "00:15:11",
  "text": "那些臘肉是一粒粒的"
 },
 {
  "t": "00:15:13",
  "text": "很香的胡椒粉味啦"
 },
 {
  "t": "00:15:16",
  "text": "蘿蔔糕不會黏牙"
 },
 {
  "t": "00:15:18",
  "text": "我覺得這個可以"
 },
 {
  "t": "00:15:22",
  "text": "啊，以前呢"
 },
 {
  "t": "00:15:23",
  "text": "就說這裡有塊牌子"
 },
 {
  "t": "00:15:24",
  "text": "寫著華人與狗不得入內的"
 },
 {
  "t": "00:15:27",
  "text": "究竟有沒有這塊牌子呢"
 },
 {
  "t": "00:15:29",
  "text": "我看過一些資料"
 },
 {
  "t": "00:15:30",
  "text": "我又找不到在沙面"
 },
 {
  "t": "00:15:32",
  "text": "又說什麼華人與狗不得入內這個牌子"
 },
 {
  "t": "00:15:36",
  "text": "相傳就是說，看回在上海租界的"
 },
 {
  "t": "00:15:40",
  "text": "黃浦公園那裡呢"
 },
 {
  "t": "00:15:42",
  "text": "是有這個華人與狗不得入內這樣的"
 },
 {
  "t": "00:15:45",
  "text": "種族歧視的牌子"
 },
 {
  "t": "00:15:47",
  "text": "那在周作人他自己的日記裡面"
 },
 {
  "t": "00:15:50",
  "text": "1903年啊"
 },
 {
  "t": "00:15:52",
  "text": "嗯"
 },
 {
  "t": "00:15:52",
  "text": "他寫到就看到公園的門口"
 },
 {
  "t": "00:15:54",
  "text": "就見到一個牌子"
 },
 {
  "t": "00:15:56",
  "text": "又寫著「犬與華人就不准入內」"
 },
 {
  "t": "00:16:00",
  "text": "那無論怎樣都好啦"
 },
 {
  "t": "00:16:01",
  "text": "就是其實也看到"
 },
 {
  "t": "00:16:03",
  "text": "就是舊中國啊"
 },
 {
  "t": "00:16:06",
  "text": "舊社會那個時候呢"
 },
 {
  "t": "00:16:07",
  "text": "就是這些對華人的歧視啊"
 },
 {
  "t": "00:16:11",
  "text": "是普遍存在的"
 },
 {
  "t": "00:16:12",
  "text": "嗯"
 },
 {
  "t": "00:16:13",
  "text": "是吧，如果不是就沒有這麼多人看到嘛"
 },
 {
  "t": "00:16:15",
  "text": "是啊"
 },
 {
  "t": "00:16:16",
  "text": "那我看到的呢就是電影啊"
 },
 {
  "t": "00:16:18",
  "text": "李小龍的精武門"
 },
 {
  "t": "00:16:20",
  "text": "啊，精武門"
 },
 {
  "t": "00:16:20",
  "text": "嗯"
 },
 {
  "t": "00:16:21",
  "text": "它裡面不就是說他進那個公園裡面嘛"
 },
 {
  "t": "00:16:24",
  "text": "嗯"
 },
 {
  "t": "00:16:24",
  "text": "但是就在門口被一個印度警察攔住"
 },
 {
  "t": "00:16:27",
  "text": "嗯"
 },
 {
  "t": "00:16:27",
  "text": "看看"
 },
 {
  "t": "00:16:28",
  "text": "不行啊，你這裡就不許看"
 },
 {
  "t": "00:16:30",
  "text": "進去看看"
 },
 {
  "t": "00:16:31",
  "text": "不行"
 },
 {
  "t": "00:16:32",
  "text": "看看那個"
 },
 {
  "t": "00:16:37",
  "text": "啊"
 },
 {
  "t": "00:16:40",
  "text": "打完日本人之後"
 },
 {
  "t": "00:16:42",
  "text": "有個日本人說，你扮狗啊"
 },
 {
  "t": "00:16:44",
  "text": "扮狗啊就讓你進去啊，那不就打他嘛"
 },
 {
  "t": "00:16:46",
  "text": "當然啦"
 },
 {
  "t": "00:16:47",
  "text": "很想進去玩一下嗎"
 },
 {
  "t": "00:16:50",
  "text": "啊，來來來，你先趴下"
 },
 {
  "t": "00:16:52",
  "text": "你當自己是大日本的狗仔"
 },
 {
  "t": "00:16:55",
  "text": "我帶你進去玩，嗯哈哈哈"
 },
 {
  "t": "00:16:59",
  "text": "啊"
 },
 {
  "t": "00:17:05",
  "text": "是，這個是"
 },
 {
  "t": "00:17:05",
  "text": "這個是種族歧視來的嘛"
 },
 {
  "t": "00:17:07",
  "text": "歧視大辱啊"
 },
 {
  "t": "00:17:08",
  "text": "嗯"
 },
 {
  "t": "00:17:10",
  "text": "試一下這個蛋撻"
 },
 {
  "t": "00:17:11",
  "text": "它這個蛋撻就很精緻"
 },
 {
  "t": "00:17:13",
  "text": "一碟就只三個"
 },
 {
  "t": "00:17:15",
  "text": "而且不是很大的，這樣小小的"
 },
 {
  "t": "00:17:17",
  "text": "但是它就是一些傳統的酥皮蛋撻"
 },
 {
  "t": "00:17:21",
  "text": "那它那酥皮也做得挺漂亮的"
 },
 {
  "t": "00:17:25",
  "text": "挺厚的，而且看到是一層層啦"
 },
 {
  "t": "00:17:27",
  "text": "吃一下看看夠不夠鬆化"
 },
 {
  "t": "00:17:31",
  "text": "嗯"
 },
 {
  "t": "00:17:33",
  "text": "它也挺酥的"
 },
 {
  "t": "00:17:35",
  "text": "我覺得就稍微甜了一點點"
 },
 {
  "t": "00:17:37",
  "text": "但是其實都是挺好吃的"
 },
 {
  "t": "00:17:40",
  "text": "它裡面的蛋漿不會太散啦"
 },
 {
  "t": "00:17:42",
  "text": "是剛剛好啊"
 },
 {
  "t": "00:17:44",
  "text": "而且很香牛油味"
 },
 {
  "t": "00:17:48",
  "text": "好像說以前這裡附近有個叫做"
 },
 {
  "t": "00:17:50",
  "text": "綠雅亭的地方"
 },
 {
  "t": "00:17:53",
  "text": "白鵝潭那邊嘛"
 },
 {
  "t": "00:17:54",
  "text": "哦"
 },
 {
  "t": "00:17:55",
  "text": "白鵝潭啊"
 },
 {
  "t": "00:17:56",
  "text": "我沒見過啊，因為是聽我爸說起的而已"
 },
 {
  "t": "00:18:00",
  "text": "啊"
 },
 {
  "t": "00:18:01",
  "text": "就從那個白鵝潭那裡伸了那個好像"
 },
 {
  "t": "00:18:04",
  "text": "一條長的碼頭出去，這樣有個艇的"
 },
 {
  "t": "00:18:07",
  "text": "啊"
 },
 {
  "t": "00:18:08",
  "text": "是啊，那綠瓦亭後來拆了"
 },
 {
  "t": "00:18:12",
  "text": "那裡原來就是羊城八景嘛"
 },
 {
  "t": "00:18:14",
  "text": "舊的羊城八景嘛"
 },
 {
  "t": "00:18:15",
  "text": "嗯"
 },
 {
  "t": "00:18:15",
  "text": "就叫鵝潭夜月啊"
 },
 {
  "t": "00:18:18",
  "text": "紅線女啊，她還作了首曲"
 },
 {
  "t": "00:18:23",
  "text": "珠江瀲灩玉帶繚繞白雲山"
 },
 {
  "t": "00:18:30",
  "text": "隔岸稻田金濤浪瀾"
 },
 {
  "t": "00:18:34",
  "text": "這個是套餐裡面的石螺芋頭粥啊"
 },
 {
  "t": "00:18:37",
  "text": "看上去料就挺多"
 },
 {
  "t": "00:18:39",
  "text": "有一粒粒的芋頭啦"
 },
 {
  "t": "00:18:41",
  "text": "那不就有一粒粒的螺肉啊"
 },
 {
  "t": "00:18:44",
  "text": "還有一些花生粒的，有些薑絲啦"
 },
 {
  "t": "00:18:48",
  "text": "好像不錯，盛一碗給你啊"
 },
 {
  "t": "00:18:58",
  "text": "現在廣州吃艇仔粥啊，那些都多"
 },
 {
  "t": "00:19:01",
  "text": "嗯"
 },
 {
  "t": "00:19:01",
  "text": "但石螺粥就很少了"
 },
 {
  "t": "00:19:03",
  "text": "是啊，真的"
 },
 {
  "t": "00:19:04",
  "text": "不是到處都有得吃的"
 },
 {
  "t": "00:19:05",
  "text": "啊"
 },
 {
  "t": "00:19:05",
  "text": "上次我們在龍渡尾啊"
 },
 {
  "t": "00:19:08",
  "text": "不是吃過一次的"
 },
 {
  "t": "00:19:10",
  "text": "嗯"
 },
 {
  "t": "00:19:11",
  "text": "都挺好吃的，這個都"
 },
 {
  "t": "00:19:13",
  "text": "嗯"
 },
 {
  "t": "00:19:14",
  "text": "是啊"
 },
 {
  "t": "00:19:16",
  "text": "我覺得這個老老實實來講"
 },
 {
  "t": "00:19:18",
  "text": "這個真的正宗一些，給我的感覺"
 },
 {
  "t": "00:19:20",
  "text": "嗯"
 },
 {
  "t": "00:19:20",
  "text": "就像我小時候吃那些石螺粥"
 },
 {
  "t": "00:19:24",
  "text": "現在比較可惜就是在沙基湧那裡啊"
 },
 {
  "t": "00:19:26",
  "text": "就沒有了，沒沒有了艇仔啊"
 },
 {
  "t": "00:19:29",
  "text": "嗯"
 },
 {
  "t": "00:19:29",
  "text": "以前很多艇仔的"
 },
 {
  "t": "00:19:31",
  "text": "是啊，以前很多在那個湧邊那裡"
 },
 {
  "t": "00:19:33",
  "text": "是啊"
 },
 {
  "t": "00:19:33",
  "text": "賣粥嘛"
 },
 {
  "t": "00:19:34",
  "text": "嗯，有個棚仔這樣"
 },
 {
  "t": "00:19:35",
  "text": "你又你又在那裡買買買些粥啊"
 },
 {
  "t": "00:19:39",
  "text": "誒，有艇仔粥啊，有石螺粥啊，是吧"
 },
 {
  "t": "00:19:42",
  "text": "炒個田螺啊這樣"
 },
 {
  "t": "00:19:44",
  "text": "這個是蒸排骨啊"
 },
 {
  "t": "00:19:47",
  "text": "那它那排骨也不會說全是骨頭這樣的"
 },
 {
  "t": "00:19:50",
  "text": "都很多肉的"
 },
 {
  "t": "00:19:52",
  "text": "那我又，那又是你願意"
 },
 {
  "t": "00:19:55",
  "text": "那底下就墊了些芋頭啦"
 },
 {
  "t": "00:19:59",
  "text": "那些芋頭是走過油的"
 },
 {
  "t": "00:20:03",
  "text": "試一下排骨啦，好像挺香的"
 },
 {
  "t": "00:20:08",
  "text": "好吃哦"
 },
 {
  "t": "00:20:13",
  "text": "它也不會硬"
 },
 {
  "t": "00:20:18",
  "text": "蒜香味都挺好啊"
 },
 {
  "t": "00:20:20",
  "text": "嗯"
 },
 {
  "t": "00:20:21",
  "text": "又不會難咬"
 },
 {
  "t": "00:20:22",
  "text": "嗯"
 },
 {
  "t": "00:20:23",
  "text": "其實廣州人呢"
 },
 {
  "t": "00:20:25",
  "text": "就是喝茶去哪裡都要吃排骨燒賣的"
 },
 {
  "t": "00:20:27",
  "text": "是啊，標配這樣"
 },
 {
  "t": "00:20:28",
  "text": "是啊，我記得我爸以前啊小時候啊"
 },
 {
  "t": "00:20:30",
  "text": "帶我去那個新亞酒店那裡啊"
 },
 {
  "t": "00:20:34",
  "text": "嗯"
 },
 {
  "t": "00:20:34",
  "text": "喝早茶啊，兩樣東西而已"
 },
 {
  "t": "00:20:37",
  "text": "一個就是誒腸粉，一個就排骨"
 },
 {
  "t": "00:20:41",
  "text": "第三樣東西我都不記得了"
 },
 {
  "t": "00:20:43",
  "text": "哈哈哈，是啊，就兩樣東西"
 },
 {
  "t": "00:20:44",
  "text": "就是證明這兩樣，這兩樣東西是吃得最多"
 },
 {
  "t": "00:20:47",
  "text": "最吃得最多的"
 },
 {
  "t": "00:20:48",
  "text": "如果有飯呢就要個排骨飯嘛"
 },
 {
  "t": "00:20:50",
  "text": "啊"
 },
 {
  "t": "00:20:50",
  "text": "嗯"
 },
 {
  "t": "00:20:53",
  "text": "好像標配都是五隻的，是吧"
 },
 {
  "t": "00:20:56",
  "text": "上次我們在那間賓館都是五隻"
 },
 {
  "t": "00:20:57",
  "text": "上次我們吃也是五隻"
 },
 {
  "t": "00:20:59",
  "text": "是啊，看一下這裡啊"
 },
 {
  "t": "00:21:00",
  "text": "上次那個就有點炸得透"
 },
 {
  "t": "00:21:01",
  "text": "有些炸得不透，看一下這裡炸得透不透啦"
 },
 {
  "t": "00:21:03",
  "text": "要蘸多些汁才好吃的"
 },
 {
  "t": "00:21:08",
  "text": "有點辣"
 },
 {
  "t": "00:21:10",
  "text": "嗯，紫金醬蒸嘛"
 },
 {
  "t": "00:21:11",
  "text": "嗯"
 },
 {
  "t": "00:21:12",
  "text": "紫金醬是有點辣的"
 },
 {
  "t": "00:21:13",
  "text": "有點辣"
 },
 {
  "t": "00:21:14",
  "text": "嗯，但是一般這些蒸鳳爪都會"
 },
 {
  "t": "00:21:17",
  "text": "用紫金醬"
 },
 {
  "t": "00:21:17",
  "text": "嗯"
 },
 {
  "t": "00:21:18",
  "text": "這樣才夠惹味嘛"
 },
 {
  "t": "00:21:20",
  "text": "我覺得那個蒜夠透的，吃一下"
 },
 {
  "t": "00:21:23",
  "text": "可以的"
 },
 {
  "t": "00:21:26",
  "text": "不捨得走啊"
 },
 {
  "t": "00:21:27",
  "text": "是啊，真的不捨得走啊"
 },
 {
  "t": "00:21:29",
  "text": "現在外面都排隊啦，等位啦"
 },
 {
  "t": "00:21:32",
  "text": "我真的坐一天都行的，真的"
 },
 {
  "t": "00:21:33",
  "text": "是啊，上次來呢"
 },
 {
  "t": "00:21:35",
  "text": "我也會選回這個位坐啊"
 },
 {
  "t": "00:21:37",
  "text": "現在人呢就很多了"
 },
 {
  "t": "00:21:40",
  "text": "你們啊，喝完茶啦"
 },
 {
  "t": "00:21:41",
  "text": "依依不捨地離開這個勝利賓館呢"
 },
 {
  "t": "00:21:45",
  "text": "個西關月啊"
 },
 {
  "t": "00:21:46",
  "text": "嗯"
 },
 {
  "t": "00:21:46",
  "text": "今天這頓茶怎麼樣啊"
 },
 {
  "t": "00:21:48",
  "text": "挺好啊，環境又好，又坐得舒服"
 },
 {
  "t": "00:21:52",
  "text": "唉，我很久都沒試過這麼舒服喝一頓茶"
 },
 {
  "t": "00:21:55",
  "text": "是啊"
 },
 {
  "t": "00:21:55",
  "text": "景漂亮"
 },
 {
  "t": "00:21:56",
  "text": "嗯"
 },
 {
  "t": "00:21:57",
  "text": "東西又好吃"
 },
 {
  "t": "00:21:58",
  "text": "是啊，價錢其實又不是太貴"
 },
 {
  "t": "00:22:01",
  "text": "是啊，又是我喜歡那種呢"
 },
 {
  "t": "00:22:03",
  "text": "就是比較安安靜靜這樣聊一下天這樣"
 },
 {
  "t": "00:22:05",
  "text": "嗯"
 },
 {
  "t": "00:22:07",
  "text": "其實在這裡喝茶呢"
 },
 {
  "t": "00:22:08",
  "text": "真的可以坐半天的"
 },
 {
  "t": "00:22:10",
  "text": "可以"
 },
 {
  "t": "00:22:11",
  "text": "好舒服"
 },
 {
  "t": "00:22:12",
  "text": "它又不趕你走的"
 },
 {
  "t": "00:22:13",
  "text": "是啊"
 },
 {
  "t": "00:22:17",
  "text": "逛一下這個沙面啦"
 },
 {
  "t": "00:22:18",
  "text": "嗯"
 },
 {
  "t": "00:22:20",
  "text": "剛才說"
 },
 {
  "t": "00:22:20",
  "text": "你不是說那個誒游泳館就在隔壁嘛"
 },
 {
  "t": "00:22:24",
  "text": "游泳館在那邊，在旁邊那裡"
 },
 {
  "t": "00:22:26",
  "text": "就走回頭嘛，這樣就是"
 },
 {
  "t": "00:22:27",
  "text": "是啊，從這裡走出去"
 },
 {
  "t": "00:22:29",
  "text": "前面那裡就是沙面游泳場來的啦"
 },
 {
  "t": "00:22:33",
  "text": "不知道讓不讓進啦，應該呢"
 },
 {
  "t": "00:22:36",
  "text": "如果是住沙面或者附近的街坊觀眾啊"
 },
 {
  "t": "00:22:40",
  "text": "應該是來游過的"
 },
 {
  "t": "00:22:42",
  "text": "那個頂上寫著1887的"
 },
 {
  "t": "00:22:44",
  "text": "這個就是沙面泳場啦"
 },
 {
  "t": "00:22:50",
  "text": "以前這些就是外國人啊"
 },
 {
  "t": "00:22:53",
  "text": "做交際的俱樂部游泳的"
 },
 {
  "t": "00:22:55",
  "text": "哦"
 },
 {
  "t": "00:22:56",
  "text": "剛才不是說他們全部都是自來水啊"
 },
 {
  "t": "00:22:58",
  "text": "很乾淨啊，不是好像西郊啊"
 },
 {
